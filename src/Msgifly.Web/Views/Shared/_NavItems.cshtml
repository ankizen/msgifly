@using Microsoft.EntityFrameworkCore
@inject Msgifly.Web.Data.ApplicationDbContext Db
@inject Msgifly.Web.Services.Workspaces.ICurrentWorkspaceAccessor WorkspaceAccessor
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller, string? action = null) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && (action is null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase));

    // The sidebar shell is always dark (bg-slate-800/900, see SidebarNavigation/Default.cshtml) —
    // it doesn't follow the app's light/dark mode toggle. So these classes are deliberately NOT
    // theme-conditional; using `dark:` variants here would only apply when the whole app is in
    // dark mode and leave inactive items nearly invisible (light-mode gray text on a dark navy
    // sidebar) the rest of the time.
    string LinkClasses(bool active) => active
        ? "group flex items-center px-3 py-2 text-sm font-medium rounded-lg bg-emerald-600 text-white shadow-sm"
        : "group flex items-center px-3 py-2 text-sm font-medium rounded-lg text-slate-400 hover:bg-slate-700/60 hover:text-white transition-colors duration-150";

    var isAccountConnected = await Db.Workspaces.AsNoTracking()
        .Where(w => w.Id == WorkspaceAccessor.WorkspaceId)
        .Select(w => w.IsAccountConnected)
        .FirstOrDefaultAsync();
}

<a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="@LinkClasses(IsActive("Dashboard"))">
    <svg xmlns="http://www.w3.org/2000/svg" class="mr-3 h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
    </svg>
    Dashboard
</a>

