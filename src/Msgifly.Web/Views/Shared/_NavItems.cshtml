@inject Msgifly.Web.Services.Settings.ISettingsService SettingsService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller, string? action = null) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && (action is null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase));

    string LinkClasses(bool active) => active
        ? "group flex items-center px-4 py-2 text-sm font-medium rounded-r-md border-l-4 border-emerald-600 bg-emerald-50 text-emerald-700 dark:border-emerald-600 dark:bg-slate-900 dark:text-white"
        : "group flex items-center px-4 py-2 text-sm font-medium rounded-r-md text-gray-600 hover:bg-emerald-100 hover:text-emerald-800 dark:text-slate-300 dark:hover:bg-slate-700 dark:hover:text-white";

    var waSettings = await SettingsService.GetAsync<Msgifly.Web.Services.Settings.WhatsAppSettings>(nameof(Msgifly.Web.Services.Settings.WhatsAppSettings));
}

<a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="@LinkClasses(IsActive("Dashboard"))">
    <svg xmlns="http://www.w3.org/2000/svg" class="mr-3 h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
    </svg>
    Dashboard
</a>

@if (User.HasPermission("connect_account.view"))
{
    <a asp-area="Admin" asp-controller="Waba" asp-action="Index" class="@LinkClasses(IsActive("Waba"))">
        <svg xmlns="http://www.w3.org/2000/svg" class="mr-3 h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
        </svg>
        @(waSettings.IsAccountConnected ? "WABA" : "Connect WABA")
    </a>
}

