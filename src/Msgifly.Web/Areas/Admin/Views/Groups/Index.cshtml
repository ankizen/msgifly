@model List<Msgifly.Web.Models.ViewModels.GroupListItem>
@{
    ViewData["Title"] = "Groups";
}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Contact Groups</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Reusable audiences for campaigns — a saved filter that stays current, or a fixed hand-picked/CSV-uploaded list.</p>
    </div>
    <a asp-action="Create" class="inline-flex items-center px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">
        + New Group
    </a>
</div>

<div class="bg-white dark:bg-slate-800 shadow rounded-lg overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
        <thead class="bg-gray-50 dark:bg-slate-900">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Name</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Type</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Members</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Updated</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="px-4 py-6 text-center text-sm text-gray-500 dark:text-slate-400">
                    No groups yet — create one to reuse as a campaign audience.
                </td></tr>
            }
            @foreach (var group in Model)
            {
                var isDynamic = group.Type == Msgifly.Web.Models.Enums.ContactGroupType.Dynamic;
                <tr>
                    <td class="px-4 py-3 text-sm text-gray-900 dark:text-slate-100">@group.Name</td>
                    <td class="px-4 py-3 text-sm">
                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium @(isDynamic ? "bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300" : "bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-300")">
                            @(isDynamic ? "Dynamic (live filter)" : "Static (fixed list)")
                        </span>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@group.MemberCount</td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@group.UpdatedAt.ToString("dd MMM yyyy")</td>
                    <td class="px-4 py-3 text-sm text-right whitespace-nowrap">
                        @if (!isDynamic)
                        {
                            <a asp-action="Members" asp-route-id="@group.Id" class="text-emerald-600 hover:text-emerald-500 mr-3">Manage members</a>
                        }
                        <a asp-action="Edit" asp-route-id="@group.Id" class="text-emerald-600 hover:text-emerald-500 mr-3">Edit</a>
                        <form asp-action="Delete" asp-route-id="@group.Id" method="post" class="inline"
                              onsubmit="return confirm('Delete &quot;@group.Name&quot;? Campaigns already created from this group keep their recipients.');">
                            <button type="submit" class="text-red-600 hover:text-red-500">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
