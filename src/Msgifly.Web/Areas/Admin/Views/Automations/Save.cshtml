@model Msgifly.Web.Models.ViewModels.AutomationFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit Automation" : "New Automation";
}

<div class="mb-4">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">@ViewData["Title"]</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Drag steps onto the canvas and connect them. A Condition node has two outputs — Yes and No.</p>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="mb-4 rounded-md bg-red-50 dark:bg-red-900/30 p-3 text-sm text-red-700 dark:text-red-300">
        <div asp-validation-summary="All"></div>
    </div>
}

<form asp-action="Save" asp-route-id="@Model.Id" method="post" id="automationForm" class="space-y-4">
    <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
            <label asp-for="Name" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
            <input asp-for="Name" placeholder="Welcome new leads"
                   class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
            <span asp-validation-for="Name" class="mt-1 block text-sm text-red-600"></span>
        </div>
        <div class="sm:col-span-2">
            <label asp-for="Description" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
            <input asp-for="Description" placeholder="Optional note for your own reference"
                   class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
        </div>
        <label class="inline-flex items-center gap-2">
            <input asp-for="IsActive" type="checkbox" class="rounded border-gray-300 text-emerald-600 shadow-sm focus:ring-emerald-500" />
            <span class="text-sm text-gray-700 dark:text-slate-300">Active</span>
        </label>
    </div>

    <div class="bg-white dark:bg-slate-800 shadow rounded-lg overflow-hidden" x-data="automationCanvasController()">
        <template x-if="sessionWindowWarning">
            <div class="p-3 border-b border-gray-200 dark:border-slate-700 bg-amber-50 dark:bg-amber-900/20 text-sm text-amber-800 dark:text-amber-300 flex items-start gap-2">
                <span class="flex-shrink-0">⚠️</span>
                <span x-text="sessionWindowWarning"></span>
            </div>
        </template>
        <div class="flex flex-wrap items-center gap-2 p-3 border-b border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-900">
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-slate-400 mr-1">Add step:</span>
            <template x-for="[type, def] in Object.entries(stepDefs)" :key="type">
                <button type="button" draggable="true"
                        x-on:dragstart="canvas.startDrag($event, type)"
                        x-on:click="canvas.addStepNode(type)"
                        class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-md border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-xs font-medium text-gray-700 dark:text-slate-300 hover:bg-emerald-50 dark:hover:bg-slate-700 cursor-grab">
                    <span x-text="def.icon"></span> <span x-text="def.label"></span>
                </button>
            </template>
            <div class="ml-auto flex items-center gap-1">
                <button type="button" x-on:click="canvas.zoomOut()" class="px-2 py-1 rounded-md border border-gray-300 dark:border-slate-600 text-gray-600 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-700" title="Zoom out">&minus;</button>
                <button type="button" x-on:click="canvas.zoomReset()" class="px-2 py-1 rounded-md border border-gray-300 dark:border-slate-600 text-gray-600 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-700 text-xs">Reset</button>
                <button type="button" x-on:click="canvas.zoomIn()" class="px-2 py-1 rounded-md border border-gray-300 dark:border-slate-600 text-gray-600 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-700" title="Zoom in">+</button>
            </div>
        </div>

        <div id="automationCanvas" class="relative w-full" style="height: 620px;"></div>
        <p class="px-3 py-2 text-xs text-gray-400 dark:text-slate-500 border-t border-gray-100 dark:border-slate-700">
            Drag from an output dot to an input dot to connect steps. Double-click a connection line to add a bend point; double-click a node to delete it.
        </p>
    </div>

    <input type="hidden" name="TriggerType" x-ref="triggerTypeInput" />
    <input type="hidden" name="KeywordsCsv" x-ref="keywordsInput" />
    <input type="hidden" name="KeywordMatchType" x-ref="matchTypeInput" />
    <input type="hidden" name="KeywordCaseSensitive" x-ref="caseSensitiveInput" />
    <input type="hidden" name="InteractiveReplyIdsCsv" x-ref="replyIdsInput" />
    <input type="hidden" name="LeadFormId" x-ref="leadFormIdInput" />
    <input type="hidden" name="StepsJson" x-ref="stepsJsonInput" />

    <div class="flex items-center gap-3">
        <button type="submit" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">Save Automation</button>
        <a asp-action="Index" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700">Cancel</a>
    </div>
</form>

<style>
    .df-node-card { min-width: 220px; font-family: inherit; position: relative; }
    .df-node-title { font-weight: 600; font-size: 0.8rem; padding: 6px 10px; background: #047857; color: #fff; border-radius: 6px 6px 0 0; }
    .df-trigger-card .df-node-title { background: #1e293b; }
    .df-node-body { padding: 8px 10px; background: #fff; border-radius: 0 0 6px 6px; display: flex; flex-direction: column; gap: 4px; }

    /* Specificity note: Drawflow's own stylesheet uses ".drawflow .drawflow-node" (two classes),
       which beats a plain ".drawflow-node" override — so every rule here that touches node/port
       chrome must match or exceed that ancestor-qualified selector, or the library's default
       cyan/black debug styling silently wins. */
    .drawflow .drawflow-node {
        background: transparent;
        border: none;
        box-shadow: 0 1px 4px rgba(0,0,0,.15);
        border-radius: 6px;
        padding: 0;
        width: auto;
        /* Ports are centered on the whole node's height by default; since our cards have
           variable-height bodies (different field counts per step type), that leaves ports
           landing at a different, unpredictable row per node and makes connection lines look
           crooked. Pin them to a fixed offset (the title bar) instead, so every node's ports
           line up on the same row regardless of body content. */
        align-items: flex-start;
    }
    .drawflow .drawflow-node.selected { background: transparent; }
    .drawflow .drawflow-node.selected .df-node-body { outline: 2px solid #047857; }
    .drawflow .drawflow-node .inputs,
    .drawflow .drawflow-node .outputs { margin-top: 13px; }
    .drawflow .drawflow-node .input,
    .drawflow .drawflow-node .output { border-color: #047857; background: #fff; }
    .drawflow .drawflow-node .input { background: #10b981; }

    .df-condition-legend { position: absolute; top: 10px; right: -54px; display: flex; flex-direction: column; gap: 12px; font-size: 10px; font-weight: 600; white-space: nowrap; pointer-events: none; }

    .df-chip-row { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 2px; }
    .df-chip {
        font-size: 10px; line-height: 1.4; padding: 2px 7px; border-radius: 9999px;
        background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; cursor: pointer;
    }
    .df-chip:hover { background: #d1fae5; }
    html.dark .df-chip { background: #064e3b; color: #6ee7b7; border-color: #065f46; }
    html.dark .df-chip:hover { background: #065f46; }

    .drawflow .connection .main-path { stroke: #94a3b8; stroke-width: 2px; }
    .drawflow .connection .main-path:hover { stroke: #047857; }
    #automationCanvas { background-color: #f8fafc; background-image: radial-gradient(#cbd5e1 1px, transparent 1px); background-size: 18px 18px; }
    html.dark #automationCanvas { background-color: #0f172a; background-image: radial-gradient(#334155 1px, transparent 1px); }
    html.dark .df-node-body { background: #1e293b; color: #e2e8f0; }
</style>

@section Scripts {
<script>
    function automationCanvasController() {
        return {
            canvas: null,
            stepDefs: window.AUTOMATION_STEP_DEFS || {},
            sessionWindowWarning: null,
            init() {
                const initial = {
                    triggerType: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TriggerType)),
                    triggerFields: {
                        keywords: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.KeywordsCsv ?? "")),
                        matchtype: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.KeywordMatchType)),
                        casesensitive: @Html.Raw(Model.KeywordCaseSensitive ? "'true'" : "'false'"),
                        replyids: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.InteractiveReplyIdsCsv ?? "")),
                        leadformid: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadFormId ?? "")),
                    },
                    leadForms: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["LeadAdsForms"])),
                    templateOptions: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["TemplateOptions"], new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerOptions.Web))),
                    steps: JSON.parse(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StepsJson))),
                };
                this.canvas = window.createAutomationCanvas(document.getElementById('automationCanvas'), initial, (state) => {
                    this.sessionWindowWarning = state.sessionWindowWarning;
                });

                document.getElementById('automationForm').addEventListener('submit', () => {
                    const data = this.canvas.exportForSubmit();
                    this.$refs.triggerTypeInput.value = data.triggerType;
                    this.$refs.keywordsInput.value = data.keywords;
                    this.$refs.matchTypeInput.value = data.matchType;
                    this.$refs.caseSensitiveInput.value = data.caseSensitive ? 'true' : 'false';
                    this.$refs.replyIdsInput.value = data.replyIds;
                    this.$refs.leadFormIdInput.value = data.leadFormId;
                    this.$refs.stepsJsonInput.value = data.stepsJson;
                });
            },
        };
    }
</script>
}
