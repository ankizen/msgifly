@model Msgifly.Web.Models.ViewModels.AutomationFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit Automation" : "New Automation";
}

<div class="mb-4">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">@ViewData["Title"]</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Click a step's + to add what comes next. A Condition step branches into Yes and No.</p>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="mb-4 rounded-md bg-red-50 dark:bg-red-900/30 p-3 text-sm text-red-700 dark:text-red-300">
        <div asp-validation-summary="All"></div>
    </div>
}

<form asp-action="Save" asp-route-id="@Model.Id" method="post" id="automationForm" class="space-y-4" x-data="automationCanvasController()">
    <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
            <label asp-for="Name" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
            <input asp-for="Name" placeholder="Welcome new leads"
                   class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
            <span asp-validation-for="Name" class="mt-1 block text-sm text-red-600"></span>
        </div>
        <div class="sm:col-span-2">
            <label asp-for="Description" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
            <input asp-for="Description" placeholder="Optional note for your own reference"
                   class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
        </div>
        <label class="inline-flex items-center gap-2">
            <input asp-for="IsActive" type="checkbox" class="rounded border-gray-300 text-emerald-600 shadow-sm focus:ring-emerald-500" />
            <span class="text-sm text-gray-700 dark:text-slate-300">Active</span>
        </label>
    </div>

    <div class="bg-white dark:bg-slate-800 shadow rounded-lg overflow-hidden">
        <template x-if="sessionWindowWarning">
            <div class="p-3 border-b border-gray-200 dark:border-slate-700 bg-amber-50 dark:bg-amber-900/20 text-sm text-amber-800 dark:text-amber-300 flex items-start gap-2">
                <span class="flex-shrink-0">⚠️</span>
                <span x-text="sessionWindowWarning"></span>
            </div>
        </template>
        <template x-if="validationIssues.length > 0">
            <div class="p-3 border-b border-gray-200 dark:border-slate-700 bg-red-50 dark:bg-red-900/20 text-sm text-red-800 dark:text-red-300">
                <p class="font-medium mb-1" x-text="`${validationIssues.length} step${validationIssues.length === 1 ? '' : 's'} need${validationIssues.length === 1 ? 's' : ''} attention:`"></p>
                <ul class="space-y-0.5">
                    <template x-for="issue in validationIssues" :key="issue.nodeId + issue.message">
                        <li>
                            <button type="button" class="text-left underline decoration-dotted hover:text-red-600 dark:hover:text-red-200" x-on:click="canvas.focusNode(issue.nodeId)" x-text="issue.message"></button>
                        </li>
                    </template>
                </ul>
            </div>
        </template>
        <div class="relative">
            <div id="automationCanvas" class="relative w-full" style="height: 620px;" x-ignore></div>
            <div x-show="loading" x-cloak class="absolute inset-0 flex items-center justify-center bg-white dark:bg-slate-800" style="height: 620px;">
                <div class="flex flex-col items-center gap-2 text-gray-400 dark:text-slate-500">
                    <svg class="animate-spin h-6 w-6" viewBox="0 0 24 24" fill="none">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                    </svg>
                    <span class="text-xs">Loading canvas…</span>
                </div>
            </div>
        </div>
        <p class="px-3 py-2 text-xs text-gray-400 dark:text-slate-500 border-t border-gray-100 dark:border-slate-700">
            Click the + on any step to add what comes next. Click a step to edit it in the panel. Delete a step from that same panel — you'll be asked to confirm.
        </p>
    </div>

    <input type="hidden" name="TriggerType" x-ref="triggerTypeInput" />
    <input type="hidden" name="KeywordsCsv" x-ref="keywordsInput" />
    <input type="hidden" name="KeywordMatchType" x-ref="matchTypeInput" />
    <input type="hidden" name="KeywordCaseSensitive" x-ref="caseSensitiveInput" />
    <input type="hidden" name="InteractiveReplyIdsCsv" x-ref="replyIdsInput" />
    <input type="hidden" name="LeadFormId" x-ref="leadFormIdInput" />
    <input type="hidden" name="StepsJson" x-ref="stepsJsonInput" />

    <div class="flex items-center gap-3">
        <button type="submit" :disabled="loading" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 disabled:opacity-50 text-white text-sm font-medium">Save Automation</button>
        <a asp-action="Index" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700">Cancel</a>
        <span class="text-xs text-amber-600 dark:text-amber-400" x-show="dirty" x-cloak>&#9679; Unsaved changes</span>
    </div>
</form>

@section Scripts {
<script>
    function automationCanvasController() {
        return {
            canvas: null,
            loading: true,
            sessionWindowWarning: null,
            validationIssues: [],
            dirty: false,
            async init() {
                const initial = {
                    triggerType: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TriggerType)),
                    triggerFields: {
                        keywords: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.KeywordsCsv ?? "")),
                        matchtype: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.KeywordMatchType)),
                        casesensitive: @Html.Raw(Model.KeywordCaseSensitive ? "'true'" : "'false'"),
                        replyids: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.InteractiveReplyIdsCsv ?? "")),
                        leadformid: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadFormId ?? "")),
                    },
                    leadForms: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["LeadAdsForms"])),
                    templateOptions: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["TemplateOptions"], new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerOptions.Web))),
                    steps: JSON.parse(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StepsJson))),
                };
                const { mountAutomationBuilder } = await window.loadAutomationBuilder();
                this.canvas = mountAutomationBuilder(document.getElementById('automationCanvas'), initial, (state) => {
                    this.sessionWindowWarning = state.sessionWindowWarning;
                    this.validationIssues = state.validationIssues || [];
                    if (!state.isInitialRender) this.dirty = true;
                });
                this.loading = false;

                const form = document.getElementById('automationForm');

                // Catches everything the canvas callback above doesn't: the Name/Description/
                // Active fields, and any field typed inside the React properties panel — React
                // still renders real DOM <input>/<textarea>/<select> elements, and their
                // input/change events bubble up through the actual DOM tree like any other
                // native form control inside this <form>, same as before.
                form.addEventListener('input', () => { this.dirty = true; });
                form.addEventListener('change', () => { this.dirty = true; });

                window.addEventListener('beforeunload', (e) => {
                    if (!this.dirty) return;
                    e.preventDefault();
                    e.returnValue = '';
                });

                form.addEventListener('submit', () => {
                    const data = this.canvas.exportForSubmit();
                    this.$refs.triggerTypeInput.value = data.triggerType;
                    this.$refs.keywordsInput.value = data.keywords;
                    this.$refs.matchTypeInput.value = data.matchType;
                    this.$refs.caseSensitiveInput.value = data.caseSensitive ? 'true' : 'false';
                    this.$refs.replyIdsInput.value = data.replyIds;
                    this.$refs.leadFormIdInput.value = data.leadFormId;
                    this.$refs.stepsJsonInput.value = data.stepsJson;
                    this.dirty = false;
                });
            },
        };
    }
</script>
}
