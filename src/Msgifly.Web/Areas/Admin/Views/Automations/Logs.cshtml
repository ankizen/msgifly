@model Msgifly.Web.Models.PagedList<Msgifly.Web.Models.Entities.AutomationLog>
@{
    var automation = (Msgifly.Web.Models.Entities.Automation)ViewData["Automation"]!;
    ViewData["Title"] = $"{automation.Name} — Runs";
}

<div class="mb-6">
    <a asp-action="Index" class="text-sm text-emerald-600 hover:text-emerald-500">&larr; Automations</a>
    <h1 class="mt-1 text-2xl font-semibold text-gray-900 dark:text-white">@automation.Name</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">@automation.ExecutionCount total run(s).</p>
</div>

<div class="bg-white dark:bg-slate-800 shadow rounded-lg overflow-x-auto" x-data="{ open: null }">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
        <thead class="bg-gray-50 dark:bg-slate-900">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">When</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Trigger</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Status</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Detail</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
            @if (!Model.Items.Any())
            {
                <tr><td colspan="4" class="px-4 py-6 text-center text-sm text-gray-500 dark:text-slate-400">No runs yet.</td></tr>
            }
            @foreach (var log in Model.Items)
            {
                var badgeClass = log.Status switch
                {
                    Msgifly.Web.Models.Enums.AutomationLogStatus.Success => "bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300",
                    Msgifly.Web.Models.Enums.AutomationLogStatus.Failed => "bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-300",
                    _ => "bg-yellow-100 dark:bg-yellow-900 text-yellow-700 dark:text-yellow-300",
                };
                <tr class="cursor-pointer" x-on:click="open = open === @log.Id ? null : @log.Id">
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400 whitespace-nowrap">@log.CreatedAt.ToString("dd MMM, HH:mm:ss")</td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@log.TriggerEvent</td>
                    <td class="px-4 py-3 text-sm">
                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium @badgeClass">@log.Status</span>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">
                        <span x-show="open !== @log.Id" class="truncate block max-w-md">@(log.ErrorMessage ?? "click to view steps")</span>
                        <pre x-show="open === @log.Id" x-cloak class="whitespace-pre-wrap text-xs bg-gray-50 dark:bg-slate-900 rounded p-2 max-w-xl">@FormatSteps(log.StepsExecutedJson)</pre>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model" />

@functions {
    string FormatSteps(string json)
    {
        try
        {
            var steps = System.Text.Json.JsonSerializer.Deserialize<List<System.Text.Json.JsonElement>>(json) ?? [];
            return string.Join("\n", steps.Select(s =>
                $"{s.GetProperty("stepType").GetString()}: {s.GetProperty("status").GetString()} — {s.GetProperty("detail").GetString()}"));
        }
        catch
        {
            return json;
        }
    }
}
