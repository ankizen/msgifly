@model Msgifly.Web.Models.PagedList<Msgifly.Web.Models.Entities.Automation>
@{
    ViewData["Title"] = "Automations";
}

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Automations</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">No-code triggers, conditions, waits, and webhooks — reacts to inbound messages and new contacts.</p>
    </div>
    <a asp-action="Save" class="inline-flex items-center px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">+ New Automation</a>
</div>

<div class="bg-white dark:bg-slate-800 shadow rounded-lg overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
        <thead class="bg-gray-50 dark:bg-slate-900">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Name</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Trigger</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Runs</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Last run</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Status</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
            @if (!Model.Items.Any())
            {
                <tr><td colspan="6" class="px-4 py-6 text-center text-sm text-gray-500 dark:text-slate-400">No automations yet.</td></tr>
            }
            @foreach (var automation in Model.Items)
            {
                <tr>
                    <td class="px-4 py-3 text-sm text-gray-900 dark:text-slate-100">
                        @automation.Name
                        @if (!string.IsNullOrWhiteSpace(automation.Description))
                        {
                            <p class="text-xs text-gray-400 dark:text-slate-500">@automation.Description</p>
                        }
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@automation.TriggerType</td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">
                        <a asp-action="Logs" asp-route-id="@automation.Id" class="hover:text-emerald-600 hover:underline">@automation.ExecutionCount</a>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@(automation.LastExecutedAt?.ToString("dd MMM, HH:mm") ?? "never")</td>
                    <td class="px-4 py-3 text-sm">
                        <form asp-action="ToggleActive" asp-route-id="@automation.Id" method="post" class="inline">
                            <button type="submit" class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium @(automation.IsActive ? "bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300" : "bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-300")">
                                @(automation.IsActive ? "Active" : "Paused")
                            </button>
                        </form>
                    </td>
                    <td class="px-4 py-3 text-right text-sm space-x-3 whitespace-nowrap">
                        <a asp-action="Save" asp-route-id="@automation.Id" class="text-emerald-600 hover:text-emerald-500">Edit</a>
                        <form asp-action="Delete" asp-route-id="@automation.Id" method="post" class="inline"
                              onsubmit="return confirm('Delete &quot;@automation.Name&quot;? This also removes its run history.');">
                            <button type="submit" class="text-red-600 hover:text-red-500">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model" />
