@model Msgifly.Web.Areas.Admin.Controllers.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    (string Label, int Value, string IconBg, string IconColor, string Path) Tile(string label, int value, string iconBg, string iconColor, string path) =>
        (label, value, iconBg, iconColor, path);

    var tiles = new[]
    {
        Tile("Messages", Model.MessageCount, "bg-blue-50 dark:bg-blue-900/30", "text-blue-600 dark:text-blue-400", "M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-6l-4 4v-4z"),
        Tile("Contacts", Model.ContactCount, "bg-emerald-50 dark:bg-emerald-900/30", "text-emerald-600 dark:text-emerald-400", "M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-4a4 4 0 10-8 0 4 4 0 008 0zm6 4a4 4 0 10-8 0 4 4 0 008 0z"),
        Tile("Campaigns", Model.CampaignCount, "bg-amber-50 dark:bg-amber-900/30", "text-amber-600 dark:text-amber-400", "M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"),
        Tile("Templates", Model.TemplateCount, "bg-violet-50 dark:bg-violet-900/30", "text-violet-600 dark:text-violet-400", "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"),
    };
}

<div class="mb-6">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Dashboard</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Here's what's happening across your WhatsApp workspace.</p>
</div>

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    @foreach (var tile in tiles)
    {
        <div class="bg-white dark:bg-slate-700 rounded-lg shadow p-5 flex items-center gap-4">
            <span class="flex-shrink-0 inline-flex items-center justify-center h-11 w-11 rounded-lg @tile.IconBg @tile.IconColor">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="@tile.Path" />
                </svg>
            </span>
            <div>
                <p class="text-sm font-medium text-gray-500 dark:text-slate-400">@tile.Label</p>
                <p class="mt-0.5 text-2xl font-semibold text-gray-900 dark:text-white">@tile.Value</p>
            </div>
        </div>
    }
</div>
