@model Msgifly.Web.Models.PagedList<Msgifly.Web.Models.Entities.TemplateBot>
@{
    ViewData["Title"] = "Template Bots";
    var templateNames = (Dictionary<string, string>)(ViewData["TemplateNames"] ?? new Dictionary<string, string>());
}

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Template Bots</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Auto-replies that send an approved WhatsApp template.</p>
    </div>
    <a asp-action="Save" class="inline-flex items-center px-4 py-2 rounded-md bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium">+ New Bot</a>
</div>

<div class="bg-white dark:bg-slate-800 shadow rounded-lg overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
        <thead class="bg-gray-50 dark:bg-slate-900">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Name</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Template</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Type</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Trigger mode</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Fired</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Status</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
            @if (!Model.Items.Any())
            {
                <tr><td colspan="7" class="px-4 py-6 text-center text-sm text-gray-500 dark:text-slate-400">No template bots yet.</td></tr>
            }
            @foreach (var bot in Model.Items)
            {
                <tr>
                    <td class="px-4 py-3 text-sm text-gray-900 dark:text-slate-100">@bot.Name</td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@(bot.TemplateId is not null && templateNames.TryGetValue(bot.TemplateId, out var tn) ? tn : bot.TemplateId)</td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@bot.RelType</td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@bot.ReplyType</td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@bot.SendingCount</td>
                    <td class="px-4 py-3 text-sm">
                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium @(bot.IsActive ? "bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300" : "bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-300")">
                            @(bot.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td class="px-4 py-3 text-right text-sm space-x-3">
                        <a asp-action="Save" asp-route-id="@bot.Id" class="text-indigo-600 hover:text-indigo-500">Edit</a>
                        <button type="button" class="text-red-600 hover:text-red-500"
                                x-on:click="$dispatch('confirm-delete', { url: '@Url.Action("Delete", new { id = bot.Id })', message: 'Delete this bot?' })">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model" />
