@model Msgifly.Web.Models.PagedList<Microsoft.AspNetCore.Identity.IdentityRole<int>>
@{
    ViewData["Title"] = "Roles";
    var userCounts = (Dictionary<int, int>)ViewData["UserCounts"]!;
    var systemRole = (string)ViewData["SystemRoleName"]!;
}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Roles</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Permission sets you can assign to users.</p>
    </div>
    <a asp-action="Save" class="inline-flex items-center px-4 py-2 rounded-md bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium">
        + Add Role
    </a>
</div>

<form method="get" class="mb-4">
    <input type="text" name="search" value="@ViewData["Search"]" placeholder="Search roles..."
           class="w-full max-w-xs rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
</form>

<div class="bg-white dark:bg-slate-800 shadow rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
        <thead class="bg-gray-50 dark:bg-slate-900">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Name</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Users</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
            @if (!Model.Items.Any())
            {
                <tr><td colspan="3" class="px-4 py-6 text-center text-sm text-gray-500 dark:text-slate-400">No roles yet.</td></tr>
            }
            @foreach (var role in Model.Items)
            {
                <tr>
                    <td class="px-4 py-3 text-sm text-gray-900 dark:text-slate-100">
                        @role.Name
                        @if (role.Name == systemRole)
                        {
                            <span class="ml-2 inline-flex items-center rounded-full bg-gray-100 dark:bg-slate-700 px-2 py-0.5 text-xs font-medium text-gray-600 dark:text-slate-300">System</span>
                        }
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@userCounts.GetValueOrDefault(role.Id, 0)</td>
                    <td class="px-4 py-3 text-right text-sm space-x-3">
                        @if (role.Name != systemRole)
                        {
                            <a asp-action="Save" asp-route-id="@role.Id" class="text-indigo-600 hover:text-indigo-500">Edit</a>
                            <button type="button" class="text-red-600 hover:text-red-500"
                                    x-on:click="$dispatch('confirm-delete', { url: '@Url.Action("Delete", new { id = role.Id })', message: 'Delete this role?' })">
                                Delete
                            </button>
                        }
                        else
                        {
                            <span class="text-gray-400 dark:text-slate-600">Managed by the system</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model" />
