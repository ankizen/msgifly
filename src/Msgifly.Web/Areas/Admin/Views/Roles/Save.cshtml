@model Msgifly.Web.Models.ViewModels.RoleFormViewModel
@{
    ViewData["Title"] = Model.Id is null ? "Add Role" : "Edit Role";
    var groups = Model.AllPermissions
        .Select(p => new { Permission = p, Group = p.Contains('.') ? p[..p.IndexOf('.')] : p })
        .GroupBy(x => x.Group)
        .OrderBy(g => g.Key);
}

<div class="mb-6">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">@ViewData["Title"]</h1>
</div>

<div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6 max-w-3xl">
    <form asp-action="Save" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-600"></div>

        <label asp-for="Name" class="block text-sm font-medium text-gray-700 dark:text-slate-300">Role name</label>
        <input asp-for="Name" class="mt-1 block w-full max-w-sm rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" autofocus />
        <span asp-validation-for="Name" class="mt-1 block text-sm text-red-600"></span>

        <h2 class="mt-6 text-sm font-semibold text-gray-700 dark:text-slate-300">Permissions</h2>
        <div class="mt-2 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var group in groups)
            {
                <div class="border border-gray-200 dark:border-slate-700 rounded-md p-3">
                    <p class="text-xs font-semibold uppercase text-gray-500 dark:text-slate-400 mb-2">@group.Key.Replace('_', ' ')</p>
                    @foreach (var item in group)
                    {
                        var checkboxId = "perm-" + item.Permission.Replace('.', '-');
                        <label for="@checkboxId" class="flex items-center gap-2 py-0.5">
                            <input type="checkbox" id="@checkboxId" name="SelectedPermissions" value="@item.Permission"
                                   checked="@Model.SelectedPermissions.Contains(item.Permission)"
                                   class="rounded border-gray-300 text-emerald-600 shadow-sm focus:ring-emerald-500" />
                            <span class="text-sm text-gray-700 dark:text-slate-300">@item.Permission</span>
                        </label>
                    }
                </div>
            }
        </div>

        <div class="mt-6 flex gap-3">
            <button type="submit" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">Save</button>
            <a asp-action="Index" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium">Cancel</a>
        </div>
    </form>
</div>
