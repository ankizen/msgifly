@model Msgifly.Web.Models.PagedList<Msgifly.Web.Models.Entities.Contact>
@using Msgifly.Web.Models.ViewModels
@{
    ViewData["Title"] = "Contacts";
    var statusOptions = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["StatusOptions"]!;
    var sourceOptions = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["SourceOptions"]!;
    var leadAdsFormOptions = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["LeadAdsFormOptions"]!;
    var templateOptions = (List<TemplateOption>)ViewData["TemplateOptions"]!;
    var flowOptions = (List<FlowOption>)ViewData["FlowOptions"]!;
    var groupOptions = (List<GroupOption>)ViewData["GroupOptions"]!;
    var groupFilterOptions = (List<GroupOption>)ViewData["GroupFilterOptions"]!;
    var hasActiveFilters = !string.IsNullOrEmpty(ViewData["Search"]?.ToString())
        || ViewData["StatusId"] is not null || ViewData["SourceId"] is not null
        || !string.IsNullOrEmpty(ViewData["LeadFormId"]?.ToString()) || ViewData["GroupId"] is not null;
}

<div x-data="sendTemplateModal()" x-init="init()">

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Contacts</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Leads and customers reachable over WhatsApp.</p>
    </div>
    <div class="flex gap-2">
        <a asp-controller="Groups" asp-action="Index" class="inline-flex items-center px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700">
            Groups
        </a>
        <a asp-action="Import" class="inline-flex items-center px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700">
            Import CSV
        </a>
        <a asp-action="Save" class="inline-flex items-center px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">
            + Add Contact
        </a>
    </div>
</div>

<form method="get" class="mb-4 flex flex-wrap gap-3">
    <input type="text" name="search" value="@ViewData["Search"]" placeholder="Search name, phone, email..."
           class="w-full max-w-xs rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
    <select name="statusId" onchange="this.form.submit()" class="rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
        <option value="">All statuses</option>
        @foreach (var opt in statusOptions)
        {
            <option value="@opt.Value" selected="@(ViewData["StatusId"]?.ToString() == opt.Value)">@opt.Text</option>
        }
    </select>
    <select name="sourceId" onchange="this.form.submit()" class="rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
        <option value="">All sources</option>
        @foreach (var opt in sourceOptions)
        {
            <option value="@opt.Value" selected="@(ViewData["SourceId"]?.ToString() == opt.Value)">@opt.Text</option>
        }
    </select>
    @if (leadAdsFormOptions.Count > 0)
    {
        <select name="leadFormId" onchange="this.form.submit()" class="rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
            <option value="">All Lead Ads forms</option>
            @foreach (var opt in leadAdsFormOptions)
            {
                <option value="@opt.Value" selected="@(ViewData["LeadFormId"]?.ToString() == opt.Value)">@opt.Text</option>
            }
        </select>
    }
    @if (groupFilterOptions.Count > 0)
    {
        <select name="groupId" onchange="this.form.submit()" class="rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
            <option value="">All groups</option>
            @foreach (var g in groupFilterOptions)
            {
                <option value="@g.Id" selected="@(ViewData["GroupId"]?.ToString() == g.Id.ToString())">@g.Name (@g.Type)</option>
            }
        </select>
    }
    <button type="submit" class="px-3 py-2 text-sm rounded-md bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-300">Filter</button>
    @if (hasActiveFilters)
    {
        <a asp-action="Index" class="px-3 py-2 text-sm text-gray-500 dark:text-slate-400 hover:text-gray-700 dark:hover:text-slate-200 self-center">Clear filters</a>
    }

    @{ var pageSizeValue = ViewData["PageSize"]?.ToString() ?? "25"; }
    <select name="pageSize" onchange="this.form.submit()" class="ml-auto rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
        <option value="25" selected="@(pageSizeValue == "25")">25 / page</option>
        <option value="50" selected="@(pageSizeValue == "50")">50 / page</option>
        <option value="100" selected="@(pageSizeValue == "100")">100 / page</option>
        <option value="all" selected="@(pageSizeValue == "all")">Show all</option>
    </select>
</form>

@{ var allContactIds = string.Join(",", Model.Items.Select(c => c.Id)); }
<div x-data="{ selectedIds: [], addToGroupOpen: false, addToGroupId: '', newGroupName: '' }">
    <div x-show="selectedIds.length > 0" x-cloak class="mb-3 flex items-center gap-3 rounded-md bg-emerald-50 dark:bg-emerald-900/30 px-4 py-2.5 text-sm">
        <span class="text-emerald-800 dark:text-emerald-300 font-medium"><span x-text="selectedIds.length"></span> selected</span>
        @if (templateOptions.Count > 0)
        {
            <button type="button" class="text-emerald-700 dark:text-emerald-400 hover:text-emerald-600 font-medium"
                    x-on:click="openForBulk(selectedIds)">
                Send Template
            </button>
        }
        <button type="button" class="text-emerald-700 dark:text-emerald-400 hover:text-emerald-600 font-medium"
                x-on:click="addToGroupId = ''; newGroupName = ''; addToGroupOpen = true">
            Add to group
        </button>
        <button type="button" class="text-red-600 hover:text-red-500 font-medium"
                x-on:click="$dispatch('confirm-delete', { url: '@Url.Action("BulkDelete")?ids=' + selectedIds.join(','), message: `Delete ${selectedIds.length} contact(s)? This cannot be undone.` })">
            Delete selected
        </button>
        <button type="button" class="text-gray-500 dark:text-slate-400 hover:text-gray-700 dark:hover:text-slate-200" x-on:click="selectedIds = []">
            Clear selection
        </button>
    </div>

    <div class="bg-white dark:bg-slate-800 shadow rounded-lg overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
            <thead class="bg-gray-50 dark:bg-slate-900">
                <tr>
                    <th class="px-4 py-3 w-10">
                        <input type="checkbox" class="rounded border-gray-300 text-emerald-600 shadow-sm focus:ring-emerald-500"
                               x-bind:checked="selectedIds.length > 0 && selectedIds.length === [@allContactIds].length"
                               x-on:change="selectedIds = $event.target.checked ? [@allContactIds] : []" />
                    </th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Name</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Phone</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Status</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Source</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Assigned</th>
                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7" class="px-4 py-6 text-center text-sm text-gray-500 dark:text-slate-400">No contacts yet.</td></tr>
                }
                @foreach (var contact in Model.Items)
                {
                    <tr>
                        <td class="px-4 py-3">
                            <input type="checkbox" class="rounded border-gray-300 text-emerald-600 shadow-sm focus:ring-emerald-500"
                                   x-model.number="selectedIds" value="@contact.Id" />
                        </td>
                        <td class="px-4 py-3 text-sm text-gray-900 dark:text-slate-100">
                            <a asp-action="Save" asp-route-id="@contact.Id" class="hover:text-emerald-600 dark:hover:text-emerald-400 hover:underline">@contact.FullName</a>
                            <span class="ml-2 text-xs text-gray-400 dark:text-slate-500">@contact.Type</span>
                        </td>
                        <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@contact.Phone</td>
                        <td class="px-4 py-3 text-sm">
                            <span class="inline-flex items-center gap-1.5">
                                <span class="h-2.5 w-2.5 rounded-full" style="background-color:@contact.Status.Color"></span>
                                @contact.Status.Name
                            </span>
                        </td>
                        <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">
                            @contact.Source.Name
                            @if (!string.IsNullOrEmpty(contact.LeadAdsFormName))
                            {
                                <span class="block text-xs text-gray-400 dark:text-slate-500">@contact.LeadAdsFormName</span>
                            }
                        </td>
                        <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@(contact.AssignedTo?.FullName ?? "-")</td>
                        <td class="px-4 py-3 text-right text-sm">
                            <div class="relative inline-block text-left" x-data="{ open: false }">
                                <button type="button" x-on:click="open = !open" x-on:click.outside="open = false"
                                        class="p-1.5 rounded-md text-gray-500 dark:text-slate-400 hover:bg-gray-100 dark:hover:bg-slate-700" title="Actions">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 110-1.5.75.75 0 010 1.5zM12 12.75a.75.75 0 110-1.5.75.75 0 010 1.5zM12 18.75a.75.75 0 110-1.5.75.75 0 010 1.5z" />
                                    </svg>
                                </button>
                                <div x-show="open" x-cloak x-on:click="open = false"
                                     class="absolute right-0 z-10 mt-1 w-40 rounded-md bg-white dark:bg-slate-800 shadow-lg ring-1 ring-black/5 dark:ring-slate-700 py-1 text-left">
                                    @if (templateOptions.Count > 0)
                                    {
                                        <button type="button" class="block w-full text-left px-3 py-1.5 text-sm text-gray-700 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-slate-700"
                                                x-on:click="openFor(@contact.Id, @System.Text.Json.JsonSerializer.Serialize(contact.FullName))">
                                            Send Template
                                        </button>
                                    }
                                    @if (flowOptions.Count > 0)
                                    {
                                        <button type="button" class="block w-full text-left px-3 py-1.5 text-sm text-gray-700 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-slate-700"
                                                x-on:click="openFlowFor(@contact.Id, @System.Text.Json.JsonSerializer.Serialize(contact.FullName))">
                                            Send Flow
                                        </button>
                                    }
                                    <a asp-action="Save" asp-route-id="@contact.Id" class="block px-3 py-1.5 text-sm text-gray-700 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-slate-700">Edit</a>
                                    <button type="button" class="block w-full text-left px-3 py-1.5 text-sm text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20"
                                            x-on:click="$dispatch('confirm-delete', { url: '@Url.Action("Delete", new { id = contact.Id })', message: 'Delete this contact?' })">
                                        Delete
                                    </button>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ---------- Add to group modal ---------- *@
    <div x-show="addToGroupOpen" x-cloak class="fixed inset-0 z-40 overflow-y-auto" style="display: none;">
        <div class="fixed inset-0 bg-black/40" x-on:click="addToGroupOpen = false"></div>
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="relative bg-white dark:bg-slate-800 rounded-lg shadow-xl max-w-lg w-full p-6" x-on:click.stop>
                <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">Add to group</h2>
                <p class="text-sm text-gray-500 dark:text-slate-400 mb-4"><span x-text="selectedIds.length"></span> contact(s) selected.</p>

                <form asp-controller="Groups" asp-action="AddMembersBulk" method="post" class="space-y-4">
                    <input type="hidden" name="ids" x-bind:value="selectedIds.join(',')" />

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">Existing group</label>
                        <select name="groupId" x-model="addToGroupId" x-on:change="newGroupName = ''"
                                class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
                            <option value="">Choose a group...</option>
                            @foreach (var g in groupOptions)
                            {
                                <option value="@g.Id">@g.Name</option>
                            }
                        </select>
                    </div>

                    <div class="text-center text-xs text-gray-400 dark:text-slate-500">— or —</div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">New group name</label>
                        <input name="newGroupName" x-model="newGroupName" x-on:input="addToGroupId = ''" placeholder="e.g. Diwali offer list"
                               class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                    </div>

                    <div class="flex items-center gap-3 pt-2">
                        <button type="submit" :disabled="!addToGroupId && !newGroupName" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 disabled:opacity-50 text-white text-sm font-medium">Add</button>
                        <button type="button" x-on:click="addToGroupOpen = false" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<partial name="_Pagination" model="Model" />

@* ---------- Send Template modal ---------- *@
<div x-show="open" x-cloak class="fixed inset-0 z-40 overflow-y-auto" style="display: none;">
    <div class="fixed inset-0 bg-black/40" x-on:click="open = false"></div>
    <div class="flex min-h-full items-center justify-center p-4">
        <div class="relative bg-white dark:bg-slate-800 rounded-lg shadow-xl max-w-lg w-full p-6" x-on:click.stop>
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">Send Template</h2>
            <p class="text-sm text-gray-500 dark:text-slate-400 mb-4"
               x-text="bulkMode ? (bulkIds.length + ' contact(s) selected') : ('To: ' + contactName)"></p>

            <form id="sendTemplateForm" method="post" class="space-y-4"
                  x-bind:action="bulkMode ? '@Url.Action("BulkSendTemplate")' : '@Url.Action("SendTemplate")'">
                @Html.AntiForgeryToken()
                <input type="hidden" name="contactId" x-bind:value="contactId" />
                <input type="hidden" name="ids" x-bind:value="bulkIds.join(',')" />

                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">Template</label>
                    <select name="templateId" x-model="templateId" x-on:change="onTemplateChange()"
                            class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
                        <option value="">Choose a template...</option>
                        @foreach (var t in templateOptions)
                        {
                            <option value="@t.TemplateId">@t.Name</option>
                        }
                    </select>
                </div>

                <template x-if="selectedTemplate && selectedTemplate.headerFormat === 'TEXT' && selectedTemplate.headerParamsCount > 0">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">Header text</label>
                        <input name="headerParam" x-model="headerParam" placeholder="Value for {{1}} in the header"
                               class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm text-sm focus:border-emerald-500 focus:ring-emerald-500" />
                    </div>
                </template>
                <template x-if="selectedTemplate && ['IMAGE', 'VIDEO', 'DOCUMENT'].includes(selectedTemplate.headerFormat)">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">Header media URL</label>
                        <input name="headerParam" x-model="headerParam" placeholder="https://..."
                               class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm text-sm focus:border-emerald-500 focus:ring-emerald-500" />
                    </div>
                </template>

                <template x-if="selectedTemplate && selectedTemplate.bodyParamsCount > 0">
                    <div class="space-y-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">Body parameters</label>
                        <template x-for="(param, index) in bodyParams" :key="index">
                            <input name="bodyParams" x-model="bodyParams[index]" :placeholder="'{{' + (index + 1) + '}}'"
                                   class="block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm text-sm focus:border-emerald-500 focus:ring-emerald-500" />
                        </template>
                    </div>
                </template>

                <template x-if="selectedTemplate">
                    <p class="text-xs text-gray-400 dark:text-slate-500 bg-gray-50 dark:bg-slate-900 rounded-md p-2" x-text="selectedTemplate.bodyText"></p>
                </template>

                <div class="flex items-center gap-3 pt-2">
                    <button type="submit" :disabled="!templateId" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 disabled:opacity-50 text-white text-sm font-medium">Send</button>
                    <button type="button" x-on:click="open = false" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ---------- Send Flow modal ---------- *@
<div x-show="flowOpen" x-cloak class="fixed inset-0 z-40 overflow-y-auto" style="display: none;">
    <div class="fixed inset-0 bg-black/40" x-on:click="flowOpen = false"></div>
    <div class="flex min-h-full items-center justify-center p-4">
        <div class="relative bg-white dark:bg-slate-800 rounded-lg shadow-xl max-w-lg w-full p-6" x-on:click.stop>
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">Send Flow</h2>
            <p class="text-sm text-gray-500 dark:text-slate-400 mb-4" x-text="'To: ' + flowContactName"></p>

            <form id="sendFlowForm" asp-action="SendFlow" method="post" class="space-y-4">
                <input type="hidden" name="contactId" x-bind:value="flowContactId" />

                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">Flow</label>
                    <select name="flowId" x-model="flowId"
                            class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
                        <option value="">Choose a flow...</option>
                        @foreach (var f in flowOptions)
                        {
                            <option value="@f.MetaFlowId">@f.Name</option>
                        }
                    </select>
                </div>

                <div class="flex items-center gap-3 pt-2">
                    <button type="submit" :disabled="!flowId" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 disabled:opacity-50 text-white text-sm font-medium">Send</button>
                    <button type="button" x-on:click="flowOpen = false" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

</div>

@section Scripts {
<script>
    function sendTemplateModal() {
        return {
            open: false,
            bulkMode: false,
            bulkIds: [],
            contactId: null,
            contactName: '',
            templateId: '',
            headerParam: '',
            bodyParams: [],
            templates: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(templateOptions, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerOptions.Web))),

            flowOpen: false,
            flowContactId: null,
            flowContactName: '',
            flowId: '',

            init() {},

            openFlowFor(contactId, contactName) {
                this.flowContactId = contactId;
                this.flowContactName = contactName;
                this.flowId = '';
                this.flowOpen = true;
            },

            get selectedTemplate() {
                return this.templates.find(t => t.templateId === this.templateId) || null;
            },

            openFor(contactId, contactName) {
                this.bulkMode = false;
                this.contactId = contactId;
                this.contactName = contactName;
                this.templateId = '';
                this.headerParam = '';
                this.bodyParams = [];
                this.open = true;
            },

            openForBulk(ids) {
                this.bulkMode = true;
                this.bulkIds = ids;
                this.templateId = '';
                this.headerParam = '';
                this.bodyParams = [];
                this.open = true;
            },

            onTemplateChange() {
                const t = this.selectedTemplate;
                this.bodyParams = t ? Array.from({ length: t.bodyParamsCount }, () => '') : [];
                this.headerParam = '';
            },
        };
    }
</script>
}
