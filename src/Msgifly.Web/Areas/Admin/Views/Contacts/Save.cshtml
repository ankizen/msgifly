@using Microsoft.AspNetCore.Mvc.Rendering
@using Msgifly.Web.Models.Entities
@model Msgifly.Web.Models.ViewModels.ContactFormViewModel
@{
    ViewData["Title"] = Model.Id is null ? "Add Contact" : "Edit Contact";
    var emailListOptions = ViewData["EmailListOptions"] as List<SelectListItem> ?? [];
    var emailTagOptions = ViewData["EmailTagOptions"] as List<SelectListItem> ?? [];
    var emailCustomFields = ViewData["EmailCustomFields"] as List<EmailCustomField> ?? [];
}

<div class="mb-6">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">@ViewData["Title"]</h1>
</div>

<div x-data="{ tab: 'details' }" class="max-w-3xl">
    @if (Model.Id is not null)
    {
        <div class="mb-4 border-b border-gray-200 dark:border-slate-700">
            <nav class="-mb-px flex gap-6">
                <button type="button" x-on:click="tab = 'details'"
                        :class="tab === 'details' ? 'border-emerald-600 text-emerald-600' : 'border-transparent text-gray-500 dark:text-slate-400'"
                        class="whitespace-nowrap border-b-2 py-3 text-sm font-medium">Details</button>
                <button type="button" x-on:click="tab = 'notes'"
                        :class="tab === 'notes' ? 'border-emerald-600 text-emerald-600' : 'border-transparent text-gray-500 dark:text-slate-400'"
                        class="whitespace-nowrap border-b-2 py-3 text-sm font-medium">Notes (@Model.Notes.Count)</button>
                <button type="button" x-on:click="tab = 'email'"
                        :class="tab === 'email' ? 'border-emerald-600 text-emerald-600' : 'border-transparent text-gray-500 dark:text-slate-400'"
                        class="whitespace-nowrap border-b-2 py-3 text-sm font-medium">Email Marketing</button>
            </nav>
        </div>
    }

    <form asp-action="Save" method="post">
        <input type="hidden" asp-for="Id" />

        <div x-show="tab === 'details'" class="bg-white dark:bg-slate-800 shadow rounded-lg p-6">
            <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-600"></div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="FirstName" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <input asp-for="FirstName" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" autofocus />
                    <span asp-validation-for="FirstName" class="mt-1 block text-sm text-red-600"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <input asp-for="LastName" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                    <span asp-validation-for="LastName" class="mt-1 block text-sm text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Phone" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <input asp-for="Phone" id="phone" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                    <span asp-validation-for="Phone" class="mt-1 block text-sm text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <input asp-for="Email" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                    <span asp-validation-for="Email" class="mt-1 block text-sm text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Company" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <input asp-for="Company" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                </div>
                <div>
                    <label asp-for="Type" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <select asp-for="Type" asp-items="Html.GetEnumSelectList<Msgifly.Web.Models.Enums.ContactType>()" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500"></select>
                </div>
                <div>
                    <label asp-for="StatusId" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <select asp-for="StatusId" asp-items="Model.StatusOptions" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500"></select>
                    <span asp-validation-for="StatusId" class="mt-1 block text-sm text-red-600"></span>
                </div>
                <div>
                    <label asp-for="SourceId" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <select asp-for="SourceId" asp-items="Model.SourceOptions" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500"></select>
                    <span asp-validation-for="SourceId" class="mt-1 block text-sm text-red-600"></span>
                </div>
                <div>
                    <label asp-for="AssignedToId" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <select asp-for="AssignedToId" asp-items="Model.AssigneeOptions" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
                        <option value="">-- Unassigned --</option>
                    </select>
                </div>
                <div>
                    <label asp-for="City" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <input asp-for="City" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                </div>
                <div>
                    <label asp-for="State" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <input asp-for="State" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                </div>
                <div>
                    <label asp-for="Zip" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <input asp-for="Zip" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                </div>
                <div>
                    <label asp-for="Website" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <input asp-for="Website" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                </div>
                <div class="sm:col-span-2">
                    <label asp-for="Address" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <input asp-for="Address" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                </div>
                <div class="sm:col-span-2">
                    <label asp-for="Description" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <textarea asp-for="Description" rows="3" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500"></textarea>
                </div>
            </div>

            <label class="mt-4 inline-flex items-center gap-2">
                <input asp-for="IsEnabled" class="rounded border-gray-300 text-emerald-600 shadow-sm focus:ring-emerald-500" />
                <span class="text-sm text-gray-700 dark:text-slate-300">@Html.DisplayNameFor(m => m.IsEnabled)</span>
            </label>
        </div>

        @if (Model.Id is not null)
        {
            <div x-show="tab === 'email'" x-cloak class="bg-white dark:bg-slate-800 shadow rounded-lg p-6 space-y-6">
                <div>
                    <label asp-for="EmailStatus" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <select asp-for="EmailStatus" asp-items="Html.GetEnumSelectList<Msgifly.Web.Models.Enums.EmailSubscriberStatus>()"
                            class="mt-1 block w-full max-w-xs rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500"></select>
                    <p class="mt-1 text-xs text-gray-400 dark:text-slate-500">Only Subscribed/Transactional contacts receive bulk email campaigns. Requires an Email address above.</p>
                </div>

                @if (emailListOptions.Count > 0)
                {
                    <div>
                        <span class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Lists</span>
                        <div class="space-y-1 max-h-40 overflow-y-auto rounded-md border border-gray-200 dark:border-slate-700 p-2">
                            @foreach (var item in emailListOptions)
                            {
                                var listId = int.Parse(item.Value!);
                                <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-slate-300">
                                    <input type="checkbox" name="SelectedListIds" value="@item.Value" checked="@Model.SelectedListIds.Contains(listId)"
                                           class="rounded border-gray-300 text-emerald-600 shadow-sm focus:ring-emerald-500" />
                                    @item.Text
                                </label>
                            }
                        </div>
                    </div>
                }
                @if (emailTagOptions.Count > 0)
                {
                    <div>
                        <span class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Tags</span>
                        <div class="space-y-1 max-h-40 overflow-y-auto rounded-md border border-gray-200 dark:border-slate-700 p-2">
                            @foreach (var item in emailTagOptions)
                            {
                                var tagId = int.Parse(item.Value!);
                                <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-slate-300">
                                    <input type="checkbox" name="SelectedTagIds" value="@item.Value" checked="@Model.SelectedTagIds.Contains(tagId)"
                                           class="rounded border-gray-300 text-emerald-600 shadow-sm focus:ring-emerald-500" />
                                    @item.Text
                                </label>
                            }
                        </div>
                    </div>
                }
                @if (emailListOptions.Count == 0 && emailTagOptions.Count == 0)
                {
                    <p class="text-sm text-gray-500 dark:text-slate-400">
                        No lists or tags yet — create some under
                        <a asp-area="Admin" asp-controller="EmailLists" asp-action="Index" class="text-emerald-600 hover:text-emerald-500">Email Marketing</a>.
                    </p>
                }

                @if (emailCustomFields.Count > 0)
                {
                    <div class="border-t border-gray-100 dark:border-slate-700 pt-4">
                        <p class="text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Custom fields</p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            @foreach (var field in emailCustomFields)
                            {
                                Model.EmailCustomFieldValues.TryGetValue(field.Key, out var value);
                                <div>
                                    <label class="block text-sm text-gray-700 dark:text-slate-300">@field.Label</label>
                                    <input type="text" name="EmailCustomFieldValues[@field.Key]" value="@value"
                                           class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                                </div>
                            }
                        </div>
                    </div>
                }
                <p class="text-xs text-gray-400 dark:text-slate-500">
                    <a asp-area="Admin" asp-controller="EmailCustomFields" asp-action="Index" class="text-emerald-600 hover:text-emerald-500">Manage custom fields</a>
                </p>
            </div>
        }

        <div class="mt-6 flex gap-3">
            <button type="submit" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">Save</button>
            <a asp-action="Index" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium">Cancel</a>
        </div>
    </form>

    @if (Model.Id is not null)
    {
        <div x-show="tab === 'notes'" x-cloak class="bg-white dark:bg-slate-800 shadow rounded-lg p-6">
            <form asp-action="AddNote" method="post" class="flex gap-2 mb-4">
                <input type="hidden" name="contactId" value="@Model.Id" />
                <input type="text" name="description" placeholder="Add a note..." required
                       class="flex-1 rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                <button type="submit" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">Add</button>
            </form>

            <div class="space-y-3">
                @if (!Model.Notes.Any())
                {
                    <p class="text-sm text-gray-500 dark:text-slate-400">No notes yet.</p>
                }
                @foreach (var note in Model.Notes)
                {
                    <div class="border border-gray-200 dark:border-slate-700 rounded-md p-3 flex justify-between items-start gap-3">
                        <div>
                            <p class="text-sm text-gray-800 dark:text-slate-200">@note.Description</p>
                            <p class="mt-1 text-xs text-gray-400 dark:text-slate-500">@note.CreatedAt.ToString("dd MMM yyyy, HH:mm")</p>
                        </div>
                        <form asp-action="DeleteNote" method="post">
                            <input type="hidden" name="noteId" value="@note.Id" />
                            <button type="submit" class="text-red-600 hover:text-red-500 text-sm">Delete</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
</div>
