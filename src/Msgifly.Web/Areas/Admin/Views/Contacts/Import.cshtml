@{
    ViewData["Title"] = "Import Contacts";
}

<div class="mb-6">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Import Contacts</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Upload a CSV file to bulk-create contacts.</p>
</div>

<div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6 max-w-lg">
    <form asp-action="Import" method="post" enctype="multipart/form-data">
        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">Contact type</label>
        <select name="type" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
            <option value="Lead">Lead</option>
            <option value="Customer">Customer</option>
        </select>

        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mt-4">CSV file</label>
        <input type="file" name="file" accept=".csv" required
               class="mt-1 block w-full text-sm text-gray-700 dark:text-slate-300 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:bg-emerald-50 dark:file:bg-slate-700 file:text-emerald-700 dark:file:text-slate-200 file:text-sm file:font-medium" />

        <p class="mt-3 text-xs text-gray-500 dark:text-slate-400">
            Expected columns: <code>firstname</code> (required), <code>lastname</code>, <code>phone</code> (required), <code>email</code>, <code>company</code>.
            New contacts get the default Status and the first Source; assign/reassign them afterwards from the contacts list.
        </p>

        <div class="mt-6 flex gap-3">
            <button type="submit" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">Upload &amp; Import</button>
            <a asp-action="Index" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium">Cancel</a>
        </div>
    </form>
</div>
