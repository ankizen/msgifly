@using Msgifly.Web.Areas.Admin.Controllers
@using Msgifly.Web.Models.Entities
@{
    ViewData["Title"] = "Lead Ads Sync";
    var workspace = (Workspace)ViewData["Workspace"]!;
    var importedCount = (int)ViewData["ImportedCount"]!;
    var isConnected = !string.IsNullOrEmpty(workspace.FacebookPageId);
}

<div class="mb-6">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Lead Ads Sync</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Automatically import new leads from this business's Facebook Instant Forms as Contacts.</p>
</div>

<div class="max-w-2xl space-y-6">
    <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6">
        @if (!isConnected)
        {
            <p class="text-sm text-gray-600 dark:text-slate-400 mb-4">
                Log in with Facebook and choose the Page that runs your Lead Ads. New form submissions are imported as Contacts — instantly once realtime sync is set up below, every minute either way — with Source set to "Facebook Lead Ads".
            </p>
            <button type="button" id="connectFacebookPageBtn"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-[#1877F2] hover:bg-[#166FE5] text-white text-sm font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
                Connect Facebook Page
            </button>
            <p id="leadAdsStatus" class="mt-2 text-xs text-gray-500 dark:text-slate-400"></p>
        }
        else
        {
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-900 dark:text-slate-100">@workspace.FacebookPageName</p>
                    <p class="text-xs text-emerald-600 dark:text-emerald-400 mt-0.5">Connected &middot; @importedCount lead(s) imported so far</p>
                </div>
                <form asp-action="SyncNow" method="post">
                    <button type="submit" class="px-3 py-1.5 rounded-md border border-gray-300 dark:border-slate-600 text-sm text-gray-700 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-slate-700">Sync now</button>
                </form>
            </div>
        }
    </div>

    @if (isConnected)
    {
        <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-lg p-4 text-sm text-amber-800 dark:text-amber-300">
            <p class="font-medium mb-1">One-time step for instant sync</p>
            <p class="mb-2">Leads still sync every minute automatically either way, but to have a new lead land the moment it's submitted, add this same callback URL to your Meta App's <span class="font-mono">Webhooks</span> product — subscribe to the <span class="font-mono">page</span> object and its <span class="font-mono">leadgen</span> field (it can't be turned on from here, only per-Page opt-in can):</p>
            <p class="font-mono bg-white dark:bg-slate-900 rounded px-2 py-1 break-all">@ViewData["WebhookUrl"]</p>
        </div>
    }

    @if (isConnected)
    {
        var forms = (List<LeadAdsForm>)ViewData["Forms"]!;
        var formImportCounts = (Dictionary<string, int>)ViewData["FormImportCounts"]!;
        var formAutomations = (Dictionary<string, FormAutomationInfo>)ViewData["FormAutomations"]!;
        var catchAllAutomation = formAutomations.GetValueOrDefault(string.Empty);
        <div class="bg-white dark:bg-slate-800 shadow rounded-lg overflow-hidden">
            <div class="p-6 pb-3">
                <h2 class="text-base font-semibold text-gray-900 dark:text-white">Instant Forms</h2>
                <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">A Page can run many forms over time and not all stay active — turn on only the ones you want new leads pulled from. Newest forms first.</p>
                <p class="mt-1 text-xs text-gray-400 dark:text-slate-500">Meta only keeps a lead's data for 90 days, so syncing regularly (every minute here) is what keeps it from being lost — not a setting to worry about.</p>
            </div>
            @if (forms.Count == 0)
            {
                <p class="px-6 pb-6 text-sm text-gray-500 dark:text-slate-400">No forms found yet — click "Sync now" above, or check back after Facebook reports this Page's forms.</p>
            }
            else
            {
                <ul class="divide-y divide-gray-200 dark:divide-slate-700">
                    @foreach (var form in forms)
                    {
                        var syncedCount = formImportCounts.GetValueOrDefault(form.FormId, 0);
                        var ownAutomation = formAutomations.GetValueOrDefault(form.FormId);
                        <li class="flex items-center justify-between px-6 py-3">
                            <div>
                                <p class="text-sm font-medium text-gray-900 dark:text-slate-100">@form.FormName</p>
                                <p class="text-xs text-gray-500 dark:text-slate-400">
                                    Status: @form.Status
                                    @if (form.FormCreatedTime.HasValue)
                                    {
                                        <text> &middot; Created @form.FormCreatedTime.Value.ToString("MMM d, yyyy")</text>
                                    }
                                    @if (syncedCount > 0)
                                    {
                                        <text> &middot; @syncedCount lead(s) already synced</text>
                                    }
                                </p>
                                <p class="text-xs mt-0.5">
                                    @if (ownAutomation is not null)
                                    {
                                        <a asp-controller="Automations" asp-action="Save" asp-route-id="@ownAutomation.Id" class="text-emerald-600 hover:text-emerald-500">⚡ Automation: @ownAutomation.Name</a>
                                    }
                                    else if (catchAllAutomation is not null)
                                    {
                                        <a asp-controller="Automations" asp-action="Save" asp-route-id="@catchAllAutomation.Id" class="text-gray-400 hover:text-emerald-500">⚡ Covered by "@catchAllAutomation.Name" (applies to all forms)</a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Automations" asp-action="Save" asp-route-triggerType="FacebookLeadReceived" asp-route-leadFormId="@form.FormId" class="text-gray-400 hover:text-emerald-500">+ Set up automation for this form</a>
                                    }
                                </p>
                            </div>
                            <form asp-action="ToggleForm" asp-route-id="@form.Id" method="post">
                                <button type="submit"
                                        class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors @(form.IsEnabled ? "bg-emerald-500" : "bg-gray-300 dark:bg-slate-600")"
                                        title="@(form.IsEnabled ? "Syncing — click to turn off" : "Not syncing — click to turn on")">
                                    <span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform @(form.IsEnabled ? "translate-x-6" : "translate-x-1")"></span>
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            }
        </div>

        var recentImports = (IEnumerable<dynamic>)ViewData["RecentImports"]!;
        <div class="bg-white dark:bg-slate-800 shadow rounded-lg overflow-hidden">
            <h2 class="text-base font-semibold text-gray-900 dark:text-white p-6 pb-3">Recently imported</h2>
            <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
                <thead class="bg-gray-50 dark:bg-slate-900">
                    <tr>
                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Contact</th>
                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Imported</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
                    @if (!recentImports.Any())
                    {
                        <tr><td colspan="2" class="px-4 py-6 text-center text-sm text-gray-500 dark:text-slate-400">No leads imported yet.</td></tr>
                    }
                    @foreach (var import in recentImports)
                    {
                        <tr>
                            <td class="px-4 py-3 text-sm text-gray-900 dark:text-slate-100">@(import.ContactName ?? "(skipped — no phone number)")</td>
                            <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@import.ImportedAt</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6">
            <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-3">Danger zone</h2>
            <form asp-action="Disconnect" method="post">
                <button type="submit" class="w-full px-4 py-2 rounded-md border border-red-300 dark:border-red-800 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 text-sm font-medium">
                    Disconnect Page
                </button>
            </form>
        </div>
    }
</div>

<form id="leadAdsChoosePageForm" asp-action="ChoosePage" method="post" class="hidden">
    <input type="hidden" name="userAccessToken" id="laUserAccessToken" />
</form>

@if (!isConnected)
{
    @section Scripts {
    <script>
        document.getElementById('connectFacebookPageBtn')?.addEventListener('click', () => {
            const statusEl = document.getElementById('leadAdsStatus');
            window.startFacebookPageLogin({
                appId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string?)ViewData["FacebookAppId"] ?? "")),
                apiVersion: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string?)ViewData["ApiVersion"] ?? "v21.0")),
                onStatus: (msg) => { statusEl.textContent = msg; },
                onToken: (token) => {
                    document.getElementById('laUserAccessToken').value = token;
                    document.getElementById('leadAdsChoosePageForm').submit();
                },
            });
        });
    </script>
    }
}
