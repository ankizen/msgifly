@model Msgifly.Web.Models.ViewModels.LeadAdsFormReportViewModel
@{
    ViewData["Title"] = $"Report — {Model.FormName}";
    var funnelBase = Math.Max(Model.TemplatesSent, 1);
    int PercentOf(int count) => (int)Math.Round(count * 100.0 / funnelBase);
}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">@Model.FormName</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Ad spend to engagement — leads from this form, and how many actually got and opened the welcome message.</p>
    </div>
    <a asp-action="Index" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700">Back to Lead Ads</a>
</div>

<div class="grid grid-cols-2 sm:grid-cols-5 gap-4 mb-6">
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
        <p class="text-xs text-gray-500 dark:text-slate-400">Leads imported</p>
        <p class="text-2xl font-semibold text-gray-900 dark:text-white">@Model.LeadsImported</p>
    </div>
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
        <p class="text-xs text-gray-500 dark:text-slate-400">Template sent</p>
        <p class="text-2xl font-semibold text-gray-900 dark:text-white">@Model.TemplatesSent</p>
    </div>
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
        <p class="text-xs text-gray-500 dark:text-slate-400">Delivered</p>
        <p class="text-2xl font-semibold text-gray-900 dark:text-white">@Model.DeliveredCount</p>
        <p class="text-xs text-gray-400 dark:text-slate-500">@PercentOf(Model.DeliveredCount)% of sent</p>
    </div>
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
        <p class="text-xs text-gray-500 dark:text-slate-400">Read</p>
        <p class="text-2xl font-semibold text-gray-900 dark:text-white">@Model.ReadCount</p>
        <p class="text-xs text-gray-400 dark:text-slate-500">@PercentOf(Model.ReadCount)% of sent</p>
    </div>
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
        <p class="text-xs text-gray-500 dark:text-slate-400">Clicked (e.g. Download)</p>
        <p class="text-2xl font-semibold text-emerald-600 dark:text-emerald-400">@Model.ClickedCount</p>
        <p class="text-xs text-gray-400 dark:text-slate-500">@PercentOf(Model.ClickedCount)% of sent</p>
    </div>
</div>

@if (Model.LeadsImported > 0 && Model.TemplatesSent == 0)
{
    <div class="mb-6 rounded-md bg-amber-50 dark:bg-amber-900/20 p-3 text-sm text-amber-800 dark:text-amber-300">
        This form has leads, but none have received a template message yet — check that an automation is set up for it (see the Lead Ads page) and that it uses a "Send Template" step.
    </div>
}

<div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6 mb-6">
    <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-4">Delivery funnel</h2>
    <div class="space-y-2">
        @{
            var stages = new (string Label, int Count, string Color)[]
            {
                ("Sent", Model.TemplatesSent, "bg-gray-400 dark:bg-slate-500"),
                ("Delivered", Model.DeliveredCount, "bg-blue-500"),
                ("Read", Model.ReadCount, "bg-emerald-500"),
                ("Clicked", Model.ClickedCount, "bg-purple-500"),
            };
        }
        @foreach (var stage in stages)
        {
            <div class="flex items-center gap-3">
                <span class="w-20 text-xs text-gray-500 dark:text-slate-400 flex-shrink-0">@stage.Label</span>
                <div class="flex-1 h-5 rounded-full bg-gray-100 dark:bg-slate-900 overflow-hidden">
                    <div class="h-full @stage.Color rounded-full" style="width: @(PercentOf(stage.Count))%"></div>
                </div>
                <span class="w-12 text-xs text-gray-700 dark:text-slate-300 text-right flex-shrink-0">@stage.Count</span>
            </div>
        }
    </div>
</div>

<div class="bg-white dark:bg-slate-800 shadow rounded-lg overflow-hidden">
    <h2 class="text-base font-semibold text-gray-900 dark:text-white p-6 pb-3">By template</h2>
    @if (Model.ByTemplate.Count == 0)
    {
        <p class="px-6 pb-6 text-sm text-gray-500 dark:text-slate-400">No template messages sent to this form's leads yet.</p>
    }
    else
    {
        <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
            <thead class="bg-gray-50 dark:bg-slate-900">
                <tr>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Template</th>
                    <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Sent</th>
                    <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Clicked</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
                @foreach (var t in Model.ByTemplate)
                {
                    <tr>
                        <td class="px-4 py-3 text-sm text-gray-900 dark:text-slate-100">@t.TemplateName</td>
                        <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400 text-right">@t.Sent</td>
                        <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400 text-right">@t.Clicked</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
