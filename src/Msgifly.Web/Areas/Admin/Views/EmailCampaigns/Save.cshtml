@using Microsoft.AspNetCore.Mvc.Rendering
@model Msgifly.Web.Models.ViewModels.EmailCampaignFormViewModel
@{
    ViewData["Title"] = Model.Id is null ? "New Campaign" : "Edit Campaign";
    var listOptions = (List<SelectListItem>)ViewData["ListOptions"]!;
    var tagOptions = (List<SelectListItem>)ViewData["TagOptions"]!;
}

<div class="mb-4">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">@ViewData["Title"]</h1>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="mb-4 rounded-md bg-red-50 dark:bg-red-900/30 p-3 text-sm text-red-700 dark:text-red-300">
        <div asp-validation-summary="All"></div>
    </div>
}

<form asp-action="Save" asp-route-id="@Model.Id" method="post" class="space-y-4" x-data="{ selectAll: @(Model.SelectAll ? "true" : "false"), sendNow: @(Model.SendNow ? "true" : "false") }">
    <input type="hidden" asp-for="Id" />

    <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="sm:col-span-2">
            <label asp-for="Name" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
            <input asp-for="Name" placeholder="August newsletter" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
            <span asp-validation-for="Name" class="mt-1 block text-sm text-red-600"></span>
        </div>
        <div>
            <label asp-for="FromName" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
            <input asp-for="FromName" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
        </div>
        <div>
            <label asp-for="FromEmail" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
            <input asp-for="FromEmail" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
        </div>
        <div class="sm:col-span-2">
            <label asp-for="Subject" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
            <input asp-for="Subject" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
        </div>
        <div class="sm:col-span-2">
            <label asp-for="BodyHtml" class="block text-sm font-medium text-gray-700 dark:text-slate-300">Body (HTML)</label>
            <textarea asp-for="BodyHtml" rows="12" placeholder="&lt;p&gt;Hi {{subscriber.firstName}},&lt;/p&gt;"
                      class="mt-1 block w-full font-mono text-sm rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500"></textarea>
            <p class="mt-1 text-xs text-gray-400 dark:text-slate-500">
                Merge tags: <code>{{subscriber.firstName}}</code>, <code>{{subscriber.lastName}}</code>, <code>{{subscriber.fullName}}</code>, <code>{{subscriber.email}}</code>, <code>{{unsubscribe_link}}</code>.
            </p>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6 space-y-4">
        <p class="text-sm font-medium text-gray-700 dark:text-slate-300">Recipients</p>
        <label class="flex items-center gap-2">
            <input type="checkbox" asp-for="SelectAll" x-model="selectAll" class="rounded border-gray-300 text-emerald-600 shadow-sm focus:ring-emerald-500" />
            <span class="text-sm text-gray-700 dark:text-slate-300">All subscribed/transactional subscribers</span>
        </label>

        <div x-show="!selectAll" x-cloak class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <span class="block text-sm text-gray-700 dark:text-slate-300 mb-1">Include lists</span>
                <div class="space-y-1 max-h-32 overflow-y-auto rounded-md border border-gray-200 dark:border-slate-700 p-2">
                    @foreach (var item in listOptions)
                    {
                        var id = int.Parse(item.Value!);
                        <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-slate-300">
                            <input type="checkbox" name="IncludeListIds" value="@item.Value" checked="@Model.IncludeListIds.Contains(id)" class="rounded border-gray-300 text-emerald-600 shadow-sm focus:ring-emerald-500" />
                            @item.Text
                        </label>
                    }
                </div>
            </div>
            <div>
                <span class="block text-sm text-gray-700 dark:text-slate-300 mb-1">Include tags</span>
                <div class="space-y-1 max-h-32 overflow-y-auto rounded-md border border-gray-200 dark:border-slate-700 p-2">
                    @foreach (var item in tagOptions)
                    {
                        var id = int.Parse(item.Value!);
                        <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-slate-300">
                            <input type="checkbox" name="IncludeTagIds" value="@item.Value" checked="@Model.IncludeTagIds.Contains(id)" class="rounded border-gray-300 text-emerald-600 shadow-sm focus:ring-emerald-500" />
                            @item.Text
                        </label>
                    }
                </div>
            </div>
        </div>

        <details class="text-sm">
            <summary class="cursor-pointer text-gray-500 dark:text-slate-400">Exclude lists/tags (optional)</summary>
            <div class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <span class="block text-sm text-gray-700 dark:text-slate-300 mb-1">Exclude lists</span>
                    <div class="space-y-1 max-h-32 overflow-y-auto rounded-md border border-gray-200 dark:border-slate-700 p-2">
                        @foreach (var item in listOptions)
                        {
                            var id = int.Parse(item.Value!);
                            <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-slate-300">
                                <input type="checkbox" name="ExcludeListIds" value="@item.Value" checked="@Model.ExcludeListIds.Contains(id)" class="rounded border-gray-300 text-emerald-600 shadow-sm focus:ring-emerald-500" />
                                @item.Text
                            </label>
                        }
                    </div>
                </div>
                <div>
                    <span class="block text-sm text-gray-700 dark:text-slate-300 mb-1">Exclude tags</span>
                    <div class="space-y-1 max-h-32 overflow-y-auto rounded-md border border-gray-200 dark:border-slate-700 p-2">
                        @foreach (var item in tagOptions)
                        {
                            var id = int.Parse(item.Value!);
                            <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-slate-300">
                                <input type="checkbox" name="ExcludeTagIds" value="@item.Value" checked="@Model.ExcludeTagIds.Contains(id)" class="rounded border-gray-300 text-emerald-600 shadow-sm focus:ring-emerald-500" />
                                @item.Text
                            </label>
                        }
                    </div>
                </div>
            </div>
        </details>
    </div>

    <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6 space-y-3">
        <p class="text-sm font-medium text-gray-700 dark:text-slate-300">Schedule</p>
        <label class="flex items-center gap-2">
            <input type="checkbox" asp-for="SendNow" x-model="sendNow" class="rounded border-gray-300 text-emerald-600 shadow-sm focus:ring-emerald-500" />
            <span class="text-sm text-gray-700 dark:text-slate-300">Send now</span>
        </label>
        <div x-show="!sendNow" x-cloak>
            <label asp-for="ScheduledAt" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
            <input asp-for="ScheduledAt" type="datetime-local" class="mt-1 block w-full max-w-xs rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
        </div>
    </div>

    <div class="flex items-center gap-3">
        <button type="submit" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">Schedule Campaign</button>
        <a asp-action="Index" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium">Cancel</a>
    </div>
</form>
