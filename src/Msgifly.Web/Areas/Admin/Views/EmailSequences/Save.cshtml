@using Microsoft.AspNetCore.Mvc.Rendering
@model Msgifly.Web.Models.ViewModels.EmailSequenceFormViewModel
@{
    ViewData["Title"] = Model.Id is null ? "New Sequence" : "Edit Sequence";
    var listOptions = (List<SelectListItem>)ViewData["ListOptions"]!;
}

<div class="mb-4">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">@ViewData["Title"]</h1>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="mb-4 rounded-md bg-red-50 dark:bg-red-900/30 p-3 text-sm text-red-700 dark:text-red-300">
        <div asp-validation-summary="All"></div>
    </div>
}

@{
    // Plain @expression (auto-HTML-encoded), NOT Html.Raw — this JSON lands inside an HTML
    // ATTRIBUTE value, and Subject/BodyHtml are free-typed admin content that will routinely
    // contain '"', '<', '>' etc. Html.Raw here would dump those characters straight into an
    // attribute already delimited by '"', truncating x-data (or worse, injecting stray
    // attributes/tags) the moment any mail's subject or body contained a quote — Alpine then
    // fails to parse the mangled expression and this whole editor silently stops working.
    // Razor's default encoding round-trips safely through the browser's attribute decoder.
    var mailsJson = System.Text.Json.JsonSerializer.Serialize(Model.Mails.Select(m => new { m.Subject, m.BodyHtml, m.DelayAmount, m.DelayUnit }));
}
<form asp-action="Save" asp-route-id="@Model.Id" method="post" class="space-y-4"
      x-data="{ mails: @mailsJson }">
    <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
            <label asp-for="Name" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
            <input asp-for="Name" placeholder="7-day onboarding drip" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
            <span asp-validation-for="Name" class="mt-1 block text-sm text-red-600"></span>
        </div>
        <div>
            <label asp-for="Status" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<Msgifly.Web.Models.Enums.EmailSequenceStatus>()"
                    class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500"></select>
        </div>
        <div>
            <label asp-for="AutoEnrollListId" class="block text-sm font-medium text-gray-700 dark:text-slate-300">Auto-enroll from list</label>
            <select asp-for="AutoEnrollListId" asp-items="listOptions" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
                <option value="">— manual only —</option>
            </select>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6">
        <div class="flex items-center justify-between mb-3">
            <p class="text-sm font-medium text-gray-700 dark:text-slate-300">Emails, in order</p>
            <button type="button" class="text-sm text-emerald-600 hover:text-emerald-500" x-on:click="mails.push({ subject: '', bodyHtml: '', delayAmount: 1, delayUnit: 'days' })">+ Add email</button>
        </div>

        <template x-if="mails.length === 0">
            <p class="text-sm text-gray-500 dark:text-slate-400">No emails yet — add at least one.</p>
        </template>

        <div class="space-y-4">
            <template x-for="(mail, index) in mails" :key="index">
                <div class="rounded-md border border-gray-200 dark:border-slate-700 p-4">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-medium text-gray-500 dark:text-slate-400" x-text="'Email ' + (index + 1)"></span>
                        <button type="button" class="text-xs text-red-600 hover:text-red-500" x-on:click="mails.splice(index, 1)">Remove</button>
                    </div>
                    <label class="block text-sm text-gray-700 dark:text-slate-300">Subject</label>
                    <input type="text" :name="'Mails[' + index + '].Subject'" x-model="mail.subject" required
                           class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />

                    <label class="block text-sm text-gray-700 dark:text-slate-300 mt-3">Body (HTML)</label>
                    <textarea :name="'Mails[' + index + '].BodyHtml'" x-model="mail.bodyHtml" rows="6"
                              class="mt-1 block w-full font-mono text-sm rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500"></textarea>

                    <div class="mt-3 flex items-center gap-2">
                        <span class="text-sm text-gray-700 dark:text-slate-300">Send</span>
                        <input type="number" min="0" :name="'Mails[' + index + '].DelayAmount'" x-model.number="mail.delayAmount"
                               class="w-20 rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                        <select :name="'Mails[' + index + '].DelayUnit'" x-model="mail.delayUnit"
                                class="rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
                            <option value="minutes">minutes</option>
                            <option value="hours">hours</option>
                            <option value="days">days</option>
                        </select>
                        <span class="text-sm text-gray-500 dark:text-slate-400">after enrollment (or after the previous email)</span>
                    </div>
                </div>
            </template>
        </div>
    </div>

    <div class="flex items-center gap-3">
        <button type="submit" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">Save Sequence</button>
        <a asp-action="Index" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium">Cancel</a>
    </div>
</form>
