@model Msgifly.Web.Models.ViewModels.WabaIndexViewModel
@{
    ViewData["Title"] = "WhatsApp Business Account";
}

<div class="mb-6">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">WhatsApp Business Account</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Connect Msgifly to Meta's WhatsApp Cloud API.</p>
</div>

@if (!Model.IsAccountConnected)
{
    <div class="max-w-2xl space-y-6">
        <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6">
            <div class="flex items-center gap-2 mb-3">
                <span class="flex h-6 w-6 items-center justify-center rounded-full @(Model.IsWebhookConnected ? "bg-green-600" : "bg-emerald-600") text-white text-xs font-bold">1</span>
                <h2 class="text-base font-semibold text-gray-900 dark:text-white">Register your Meta App</h2>
            </div>

            @if (Model.IsWebhookConnected)
            {
                <p class="text-sm text-gray-600 dark:text-slate-400 mb-3">Add this callback URL and verify token to your Meta App's WhatsApp &gt; Configuration &gt; Webhook settings:</p>
                <dl class="text-sm space-y-2 mb-4">
                    <div>
                        <dt class="text-xs uppercase text-gray-400 dark:text-slate-500">Callback URL</dt>
                        <dd class="font-mono bg-gray-50 dark:bg-slate-900 rounded px-2 py-1 break-all">@Model.WebhookUrl</dd>
                    </div>
                    <div>
                        <dt class="text-xs uppercase text-gray-400 dark:text-slate-500">Verify Token</dt>
                        <dd class="font-mono bg-gray-50 dark:bg-slate-900 rounded px-2 py-1 break-all">@Model.WebhookVerifyToken</dd>
                    </div>
                </dl>
                <p class="text-xs text-gray-400 dark:text-slate-500">Registered — you can update your App ID/Secret again below if needed.</p>
            }

            <form asp-action="ConnectWebhook" method="post" class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="WebhookForm.FacebookAppId" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <input asp-for="WebhookForm.FacebookAppId" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                </div>
                <div>
                    <label asp-for="WebhookForm.FacebookAppSecret" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <input asp-for="WebhookForm.FacebookAppSecret" type="password" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                </div>
                <div class="sm:col-span-2">
                    <label asp-for="WebhookForm.EmbeddedSignupConfigId" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <input asp-for="WebhookForm.EmbeddedSignupConfigId" placeholder="Optional — enables Connect via Facebook below. From Meta App, WhatsApp, Embedded Signup, Configurations."
                           class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                </div>
                <div class="sm:col-span-2">
                    <button type="submit" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">
                        @(Model.IsWebhookConnected ? "Update" : "Save & Continue")
                    </button>
                </div>
            </form>
        </div>

        <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6 @(Model.IsWebhookConnected ? "" : "opacity-50 pointer-events-none")">
            <div class="flex items-center gap-2 mb-3">
                <span class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-600 text-white text-xs font-bold">2</span>
                <h2 class="text-base font-semibold text-gray-900 dark:text-white">Connect your Business Account</h2>
            </div>

            @if (!string.IsNullOrEmpty(Model.EmbeddedSignupConfigId) && !string.IsNullOrEmpty(Model.FacebookAppId))
            {
                <div class="mb-5 pb-5 border-b border-gray-100 dark:border-slate-700">
                    <p class="text-sm text-gray-600 dark:text-slate-400 mb-3">
                        Log in with Facebook and pick (or create) this business's WhatsApp Business Account and phone number — no copying tokens by hand.
                    </p>
                    <button type="button" id="connectViaFacebookBtn"
                            class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-[#1877F2] hover:bg-[#166FE5] text-white text-sm font-medium">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
                        Connect via Facebook
                    </button>
                    <p id="embeddedSignupStatus" class="mt-2 text-xs text-gray-500 dark:text-slate-400"></p>
                </div>
                <p class="text-xs text-gray-400 dark:text-slate-500 mb-3">Or connect manually with a token:</p>
            }

            <form asp-action="ConnectAccount" method="post" class="grid grid-cols-1 gap-4">
                <div>
                    <label asp-for="AccountForm.BusinessAccountId" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <input asp-for="AccountForm.BusinessAccountId" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                </div>
                <div>
                    <label asp-for="AccountForm.AccessToken" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                    <input asp-for="AccountForm.AccessToken" type="password" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                </div>
                <div>
                    <button type="submit" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">Connect Account</button>
                </div>
            </form>
        </div>

        <form id="embeddedSignupForm" asp-action="CompleteEmbeddedSignup" method="post" class="hidden">
            <input type="hidden" name="Code" id="esCode" />
            <input type="hidden" name="WabaId" id="esWabaId" />
            <input type="hidden" name="PhoneNumberId" id="esPhoneNumberId" />
        </form>
    </div>
}
else
{
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6">
                <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-4">Phone Numbers</h2>
                @if (!Model.PhoneNumbers.Any())
                {
                    <p class="text-sm text-gray-500 dark:text-slate-400">No phone numbers found on this Business Account.</p>
                }
                <div class="divide-y divide-gray-200 dark:divide-slate-700">
                    @foreach (var number in Model.PhoneNumbers)
                    {
                        var isDefault = number.Id == Model.DefaultPhoneNumberId;
                        <div class="py-3 flex items-center justify-between">
                            <div>
                                <p class="text-sm font-medium text-gray-900 dark:text-slate-100">
                                    @number.DisplayPhoneNumber
                                    @if (isDefault)
                                    {
                                        <span class="ml-2 inline-flex items-center rounded-full bg-emerald-100 dark:bg-emerald-900 px-2 py-0.5 text-xs font-medium text-emerald-700 dark:text-emerald-300">Default</span>
                                    }
                                </p>
                                <p class="text-xs text-gray-400 dark:text-slate-500">@number.VerifiedName &middot; Quality: @(number.QualityRating ?? "unknown")</p>
                            </div>
                            @if (!isDefault)
                            {
                                <form asp-action="SetDefaultNumber" method="post">
                                    <input type="hidden" name="phoneNumberId" value="@number.Id" />
                                    <input type="hidden" name="phoneNumber" value="@number.DisplayPhoneNumber" />
                                    <button type="submit" class="text-sm text-emerald-600 hover:text-emerald-500">Set as default</button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6">
                <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-4">Send a Test Message</h2>
                <form asp-action="SendTestMessage" method="post" class="flex flex-wrap gap-2">
                    <input type="text" name="phoneNumber" placeholder="+91XXXXXXXXXX" required
                           class="flex-1 min-w-[200px] rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                    <button type="submit" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">Send</button>
                </form>
            </div>

            <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6">
                <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-1">Business Profile</h2>
                <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">What customers see when they open a chat with your number.</p>
                <form asp-action="UpdateBusinessProfile" method="post" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="sm:col-span-2">
                        <label asp-for="ProfileForm.About" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                        <input asp-for="ProfileForm.About" maxlength="139" placeholder="e.g. Marketing automation for growing businesses"
                               class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                    </div>
                    <div>
                        <label asp-for="ProfileForm.Email" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                        <input asp-for="ProfileForm.Email" placeholder="hello@yourbrand.com"
                               class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                    </div>
                    <div>
                        <label asp-for="ProfileForm.Website" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                        <input asp-for="ProfileForm.Website" placeholder="https://yourbrand.com"
                               class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                    </div>
                    <div class="sm:col-span-2">
                        <label asp-for="ProfileForm.Vertical" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                        <select asp-for="ProfileForm.Vertical"
                                class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
                            <option value="">Leave unchanged</option>
                            <option value="AUTO">Automotive</option>
                            <option value="BEAUTY">Beauty, Spa and Salon</option>
                            <option value="EDU">Education</option>
                            <option value="ENTERTAIN">Entertainment</option>
                            <option value="FINANCE">Finance and Banking</option>
                            <option value="GOVT">Government</option>
                            <option value="GROCERY">Grocery</option>
                            <option value="HEALTH">Health</option>
                            <option value="HOTEL">Hotel and Lodging</option>
                            <option value="NONPROFIT">Non-profit</option>
                            <option value="PROF_SERVICES">Professional Services</option>
                            <option value="RETAIL">Retail</option>
                            <option value="TRAVEL">Travel and Transportation</option>
                            <option value="RESTAURANT">Restaurant</option>
                            <option value="OTHER">Other</option>
                        </select>
                    </div>
                    <div class="sm:col-span-2">
                        <button type="submit" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">Save Profile</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="space-y-6">
            @if (!string.IsNullOrEmpty(Model.DefaultPhoneNumber))
            {
                <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6 text-center">
                    <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-3">Chat QR Code</h2>
                    <img src="@Url.Action("QrCode")" alt="WhatsApp QR code" class="mx-auto w-40 h-40" />
                    <p class="mt-2 text-xs text-gray-500 dark:text-slate-400">wa.me/@(new string(Model.DefaultPhoneNumber.Where(char.IsDigit).ToArray()))</p>
                </div>
            }

            <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6">
                <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-3">Danger zone</h2>
                <p class="text-sm text-gray-500 dark:text-slate-400 mb-3">Disconnecting removes the stored credentials and clears the synced template cache.</p>
                <form asp-action="Disconnect" method="post">
                    <button type="submit" class="w-full px-4 py-2 rounded-md border border-red-300 dark:border-red-800 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 text-sm font-medium">
                        Disconnect Account
                    </button>
                </form>
            </div>
        </div>
    </div>
}

@if (!Model.IsAccountConnected && !string.IsNullOrEmpty(Model.EmbeddedSignupConfigId) && !string.IsNullOrEmpty(Model.FacebookAppId))
{
    @section Scripts {
    <script>
        document.getElementById('connectViaFacebookBtn')?.addEventListener('click', () => {
            const statusEl = document.getElementById('embeddedSignupStatus');
            window.startEmbeddedSignup({
                configId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EmbeddedSignupConfigId)),
                appId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FacebookAppId)),
                apiVersion: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApiVersion)),
                onStatus: (msg) => { statusEl.textContent = msg; },
            });
        });
    </script>
    }
}
