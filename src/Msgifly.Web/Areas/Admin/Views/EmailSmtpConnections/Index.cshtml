@model Msgifly.Web.Models.PagedList<Msgifly.Web.Models.Entities.EmailSmtpConnection>
@{
    ViewData["Title"] = "SMTP Connections";
}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">SMTP Connections</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Generic SMTP relay credentials used to send campaigns, automations, and sequences.</p>
    </div>
    <a asp-action="Save" class="inline-flex items-center px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">
        + Add Connection
    </a>
</div>

<div class="bg-white dark:bg-slate-800 shadow rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
        <thead class="bg-gray-50 dark:bg-slate-900">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Name</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">From</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Host</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Status</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
            @if (!Model.Items.Any())
            {
                <tr><td colspan="5" class="px-4 py-6 text-center text-sm text-gray-500 dark:text-slate-400">No SMTP connections yet — add one to start sending.</td></tr>
            }
            @foreach (var connection in Model.Items)
            {
                <tr>
                    <td class="px-4 py-3 text-sm text-gray-900 dark:text-slate-100">
                        @connection.Name
                        @if (connection.IsDefault)
                        {
                            <span class="ml-2 inline-flex items-center rounded-full bg-emerald-50 dark:bg-emerald-900/30 px-2 py-0.5 text-xs font-medium text-emerald-700 dark:text-emerald-300">Default</span>
                        }
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@connection.FromEmail</td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@connection.Host:@connection.Port</td>
                    <td class="px-4 py-3 text-sm">
                        @if (connection.IsActive)
                        {
                            <span class="text-emerald-600">Active</span>
                        }
                        else
                        {
                            <span class="text-gray-400">Inactive</span>
                        }
                    </td>
                    <td class="px-4 py-3 text-right text-sm space-x-3">
                        <a asp-action="Save" asp-route-id="@connection.Id" class="text-emerald-600 hover:text-emerald-500">Edit</a>
                        <button type="button" class="text-red-600 hover:text-red-500"
                                x-on:click="$dispatch('confirm-delete', { url: '@Url.Action("Delete", new { id = connection.Id })', message: 'Delete this SMTP connection?' })">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model" />
