@using Microsoft.AspNetCore.Mvc.Rendering
@model Msgifly.Web.Models.PagedList<Msgifly.Web.Models.Entities.EmailSubscriber>
@{
    ViewData["Title"] = "Email Subscribers";
    var listOptions = (List<SelectListItem>)ViewData["ListOptions"]!;
    var tagOptions = (List<SelectListItem>)ViewData["TagOptions"]!;
    var automationOptions = (List<SelectListItem>)ViewData["AutomationOptions"]!;
    var sequenceOptions = (List<SelectListItem>)ViewData["SequenceOptions"]!;
}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Email Subscribers</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Your email contact list — lists, tags, and custom fields live here.</p>
    </div>
    <div class="flex gap-2">
        <a asp-action="CustomFields" class="inline-flex items-center px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700">
            Custom Fields
        </a>
        <a asp-action="Import" class="inline-flex items-center px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700">
            Import CSV
        </a>
        <a asp-action="Save" class="inline-flex items-center px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">
            + Add Subscriber
        </a>
    </div>
</div>

<form method="get" class="mb-4 flex flex-wrap gap-3">
    <input type="text" name="search" value="@ViewData["Search"]" placeholder="Search email or name..."
           class="w-full max-w-xs rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
    <select name="status" class="rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
        <option value="">All statuses</option>
        @foreach (var value in Enum.GetValues<Msgifly.Web.Models.Enums.EmailSubscriberStatus>())
        {
            <option value="@value" selected="@(ViewData["StatusFilter"]?.ToString() == value.ToString())">@value</option>
        }
    </select>
    <select name="listId" class="rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
        <option value="">All lists</option>
        @foreach (var item in listOptions)
        {
            <option value="@item.Value" selected="@(ViewData["ListFilter"]?.ToString() == item.Value)">@item.Text</option>
        }
    </select>
    <select name="tagId" class="rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
        <option value="">All tags</option>
        @foreach (var item in tagOptions)
        {
            <option value="@item.Value" selected="@(ViewData["TagFilter"]?.ToString() == item.Value)">@item.Text</option>
        }
    </select>
    <button type="submit" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700">Filter</button>
</form>

<div class="bg-white dark:bg-slate-800 shadow rounded-lg overflow-hidden overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
        <thead class="bg-gray-50 dark:bg-slate-900">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Email</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Name</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Status</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
            @if (!Model.Items.Any())
            {
                <tr><td colspan="4" class="px-4 py-6 text-center text-sm text-gray-500 dark:text-slate-400">No subscribers yet.</td></tr>
            }
            @foreach (var subscriber in Model.Items)
            {
                <tr x-data="{ open: false }">
                    <td class="px-4 py-3 text-sm text-gray-900 dark:text-slate-100">@subscriber.Email</td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@subscriber.FullName</td>
                    <td class="px-4 py-3 text-sm">
                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium
                            @(subscriber.Status == Msgifly.Web.Models.Enums.EmailSubscriberStatus.Subscribed ? "bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300"
                              : subscriber.Status == Msgifly.Web.Models.Enums.EmailSubscriberStatus.Unsubscribed ? "bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-slate-300"
                              : "bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300")">
                            @subscriber.Status
                        </span>
                    </td>
                    <td class="px-4 py-3 text-right text-sm relative">
                        <a asp-action="Save" asp-route-id="@subscriber.Id" class="text-emerald-600 hover:text-emerald-500 mr-3">Edit</a>
                        <button type="button" class="text-gray-500 hover:text-gray-700 dark:text-slate-400" x-on:click="open = !open">Actions ▾</button>
                        <div x-show="open" x-cloak x-on:click.outside="open = false" class="absolute right-4 z-10 mt-2 w-56 rounded-md bg-white dark:bg-slate-800 shadow-lg ring-1 ring-black/5 text-left">
                            <form asp-action="RunAutomation" method="post" class="px-3 py-2 border-b border-gray-100 dark:border-slate-700">
                                <input type="hidden" name="subscriberId" value="@subscriber.Id" />
                                <label class="block text-xs text-gray-500 dark:text-slate-400 mb-1">Run automation</label>
                                <select name="automationId" class="w-full text-sm rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100">
                                    @foreach (var item in automationOptions)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                                <button type="submit" class="mt-1 text-xs text-emerald-600 hover:text-emerald-500">Run now</button>
                            </form>
                            <form asp-action="AddToSequence" method="post" class="px-3 py-2 border-b border-gray-100 dark:border-slate-700">
                                <input type="hidden" name="subscriberId" value="@subscriber.Id" />
                                <label class="block text-xs text-gray-500 dark:text-slate-400 mb-1">Add to sequence</label>
                                <select name="sequenceId" class="w-full text-sm rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100">
                                    @foreach (var item in sequenceOptions)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                                <button type="submit" class="mt-1 text-xs text-emerald-600 hover:text-emerald-500">Add</button>
                            </form>
                            <button type="button" class="w-full text-left px-3 py-2 text-sm text-red-600 hover:bg-gray-50 dark:hover:bg-slate-700"
                                    x-on:click="$dispatch('confirm-delete', { url: '@Url.Action("Delete", new { id = subscriber.Id })', message: 'Delete this subscriber?' })">
                                Delete
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model" />
