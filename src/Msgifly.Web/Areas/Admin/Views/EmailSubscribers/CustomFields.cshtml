@model List<Msgifly.Web.Models.Entities.EmailCustomField>
@{
    ViewData["Title"] = "Custom Fields";
}

<div class="mb-6">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Custom Fields</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Extra fields tracked on each subscriber, available as merge tags in campaigns and automations.</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white dark:bg-slate-800 shadow rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
            <thead class="bg-gray-50 dark:bg-slate-900">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Label</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Key</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Type</th>
                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="px-4 py-6 text-center text-sm text-gray-500 dark:text-slate-400">No custom fields yet.</td></tr>
                }
                @foreach (var field in Model)
                {
                    <tr>
                        <td class="px-4 py-3 text-sm text-gray-900 dark:text-slate-100">@field.Label</td>
                        <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400"><code>@field.Key</code></td>
                        <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@field.FieldType</td>
                        <td class="px-4 py-3 text-right text-sm">
                            <button type="button" class="text-red-600 hover:text-red-500"
                                    x-on:click="$dispatch('confirm-delete', { url: '@Url.Action("DeleteCustomField", new { id = field.Id })', message: 'Delete this custom field?' })">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6">
        <h2 class="text-sm font-semibold text-gray-900 dark:text-white mb-3">Add a custom field</h2>
        <form asp-action="SaveCustomField" method="post" class="space-y-3" x-data="{ fieldType: 'Text' }">
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">Label</label>
                <input type="text" name="Label" required placeholder="Birthday"
                       class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">Key (used as a merge tag)</label>
                <input type="text" name="Key" required placeholder="birthday"
                       class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">Type</label>
                <select name="FieldType" x-model="fieldType" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
                    <option>Text</option>
                    <option>Number</option>
                    <option>Date</option>
                    <option>Dropdown</option>
                </select>
            </div>
            <div x-show="fieldType === 'Dropdown'" x-cloak>
                <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">Options (comma-separated)</label>
                <input type="text" name="OptionsCsv" placeholder="Option A, Option B"
                       class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
            </div>
            <button type="submit" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">Add field</button>
        </form>
    </div>
</div>

<div class="mt-6">
    <a asp-action="Index" class="text-sm text-gray-500 dark:text-slate-400 hover:text-gray-700 dark:hover:text-slate-200">&larr; Back to Subscribers</a>
</div>
