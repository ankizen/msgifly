@model Msgifly.Web.Models.PagedList<Msgifly.Web.Models.Entities.WhatsappTemplate>
@{
    ViewData["Title"] = "Templates";
}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">WhatsApp Templates</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Meta-approved message templates, synced from your Business Account.</p>
    </div>
    <form asp-action="Sync" method="post">
        <button type="submit" class="inline-flex items-center px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">
            Sync from Meta
        </button>
    </form>
</div>

<form method="get" class="mb-4">
    <input type="text" name="search" value="@ViewData["Search"]" placeholder="Search templates..."
           class="w-full max-w-xs rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
</form>

<div class="bg-white dark:bg-slate-800 shadow rounded-lg overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
        <thead class="bg-gray-50 dark:bg-slate-900">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Name</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Language</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Category</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Status</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Body</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
            @if (!Model.Items.Any())
            {
                <tr><td colspan="5" class="px-4 py-6 text-center text-sm text-gray-500 dark:text-slate-400">
                    No templates yet — connect your WhatsApp Business Account and sync.
                </td></tr>
            }
            @foreach (var template in Model.Items)
            {
                <tr>
                    <td class="px-4 py-3 text-sm text-gray-900 dark:text-slate-100">@template.TemplateName</td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@template.Language</td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@template.Category</td>
                    <td class="px-4 py-3 text-sm">
                        @{
                            var badgeClass = template.Status switch
                            {
                                Msgifly.Web.Models.Enums.TemplateStatus.Approved => "bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300",
                                Msgifly.Web.Models.Enums.TemplateStatus.Rejected => "bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-300",
                                _ => "bg-yellow-100 dark:bg-yellow-900 text-yellow-700 dark:text-yellow-300",
                            };
                        }
                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium @badgeClass">@template.Status</span>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400 max-w-xs truncate" title="@template.BodyText">@template.BodyText</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model" />
