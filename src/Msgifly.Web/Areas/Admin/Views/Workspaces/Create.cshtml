@{
    ViewData["Title"] = "Add Business";
}

<div class="mb-4">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Add Business</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Creates a fresh workspace with its own Contacts, Templates, Campaigns and Chat. You'll connect its WhatsApp Business Account next.</p>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="mb-4 rounded-md bg-red-50 dark:bg-red-900/30 p-3 text-sm text-red-700 dark:text-red-300">
        <div asp-validation-summary="All"></div>
    </div>
}

<form asp-action="Create" method="post" class="bg-white dark:bg-slate-800 shadow rounded-lg p-6 max-w-lg space-y-4">
    <div>
        <label for="name" class="block text-sm font-medium text-gray-700 dark:text-slate-300">Business name</label>
        <input type="text" name="name" id="name" placeholder="e.g. Acme Real Estate" autofocus
               class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
    </div>

    <div class="flex items-center gap-3">
        <button type="submit" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">Create</button>
        <a asp-action="Index" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700">Cancel</a>
    </div>
</form>
