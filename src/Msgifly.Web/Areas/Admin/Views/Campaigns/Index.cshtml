@model Msgifly.Web.Models.PagedList<Msgifly.Web.Models.ViewModels.CampaignListItem>
@{
    ViewData["Title"] = "Campaigns";
}

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Campaigns</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Bulk WhatsApp template sends to your contacts.</p>
    </div>
    <a asp-action="Save" class="inline-flex items-center px-4 py-2 rounded-md bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium">
        + New Campaign
    </a>
</div>

<div class="bg-white dark:bg-slate-800 shadow rounded-lg overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
        <thead class="bg-gray-50 dark:bg-slate-900">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Name</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Template</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Status</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Progress</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Scheduled</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
            @if (!Model.Items.Any())
            {
                <tr><td colspan="6" class="px-4 py-6 text-center text-sm text-gray-500 dark:text-slate-400">No campaigns yet.</td></tr>
            }
            @foreach (var campaign in Model.Items)
            {
                <tr>
                    <td class="px-4 py-3 text-sm text-gray-900 dark:text-slate-100">
                        @campaign.Name
                        <span class="ml-2 text-xs text-gray-400 dark:text-slate-500">@campaign.RelType</span>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@campaign.TemplateName</td>
                    <td class="px-4 py-3 text-sm">
                        @if (campaign.PauseCampaign)
                        {
                            <span class="inline-flex items-center rounded-full bg-yellow-100 dark:bg-yellow-900 px-2 py-0.5 text-xs font-medium text-yellow-700 dark:text-yellow-300">Paused</span>
                        }
                        else if (campaign.IsSent)
                        {
                            <span class="inline-flex items-center rounded-full bg-green-100 dark:bg-green-900 px-2 py-0.5 text-xs font-medium text-green-700 dark:text-green-300">Sent</span>
                        }
                        else
                        {
                            <span class="inline-flex items-center rounded-full bg-gray-100 dark:bg-slate-700 px-2 py-0.5 text-xs font-medium text-gray-700 dark:text-slate-300">Pending</span>
                        }
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">
                        @campaign.SentCount / @campaign.TotalCount sent
                        @if (campaign.FailedCount > 0)
                        {
                            <span class="text-red-500">&middot; @campaign.FailedCount failed</span>
                        }
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">
                        @(campaign.ScheduledSendTime?.ToString("dd MMM yyyy, HH:mm") ?? "Immediately")
                    </td>
                    <td class="px-4 py-3 text-right text-sm space-x-3">
                        <a asp-action="Details" asp-route-id="@campaign.Id" class="text-indigo-600 hover:text-indigo-500">Details</a>
                        @if (!campaign.IsSent)
                        {
                            <a asp-action="Save" asp-route-id="@campaign.Id" class="text-indigo-600 hover:text-indigo-500">Edit</a>
                        }
                        <button type="button" class="text-red-600 hover:text-red-500"
                                x-on:click="$dispatch('confirm-delete', { url: '@Url.Action("Delete", new { id = campaign.Id })', message: 'Delete this campaign and all its send records?' })">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model" />
