@model Msgifly.Web.Models.ViewModels.CampaignDetailsViewModel
@{
    ViewData["Title"] = Model.CampaignName;
}

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">@Model.CampaignName</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Delivery report</p>
    </div>
    <div class="flex gap-2">
        @if (Model.FailedCount > 0)
        {
            <form asp-action="RetryFailed" asp-route-id="@Model.CampaignId" method="post">
                <button type="submit" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700">
                    Retry @Model.FailedCount failed
                </button>
            </form>
        }
        @if (Model.PauseCampaign)
        {
            <form asp-action="Resume" asp-route-id="@Model.CampaignId" method="post">
                <button type="submit" class="px-4 py-2 rounded-md bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium">Resume</button>
            </form>
        }
        else if (!Model.IsSent || Model.PendingCount > 0)
        {
            <form asp-action="Pause" asp-route-id="@Model.CampaignId" method="post">
                <button type="submit" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700">Pause</button>
            </form>
        }
    </div>
</div>

<div class="grid grid-cols-2 sm:grid-cols-5 gap-4 mb-6">
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
        <p class="text-xs text-gray-500 dark:text-slate-400">Pending</p>
        <p class="text-2xl font-semibold text-gray-900 dark:text-white">@Model.PendingCount</p>
    </div>
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
        <p class="text-xs text-gray-500 dark:text-slate-400">Sent</p>
        <p class="text-2xl font-semibold text-gray-900 dark:text-white">@Model.SentCount</p>
    </div>
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
        <p class="text-xs text-gray-500 dark:text-slate-400">Delivered</p>
        <p class="text-2xl font-semibold text-gray-900 dark:text-white">@Model.DeliveredCount</p>
    </div>
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
        <p class="text-xs text-gray-500 dark:text-slate-400">Read</p>
        <p class="text-2xl font-semibold text-gray-900 dark:text-white">@Model.ReadCount</p>
    </div>
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
        <p class="text-xs text-gray-500 dark:text-slate-400">Failed</p>
        <p class="text-2xl font-semibold text-red-600">@Model.FailedCount</p>
    </div>
</div>

<div class="bg-white dark:bg-slate-800 shadow rounded-lg overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
        <thead class="bg-gray-50 dark:bg-slate-900">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Contact</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Phone</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Status</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Detail</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Updated</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
            @if (!Model.Details.Items.Any())
            {
                <tr><td colspan="5" class="px-4 py-6 text-center text-sm text-gray-500 dark:text-slate-400">No recipients.</td></tr>
            }
            @foreach (var detail in Model.Details.Items)
            {
                <tr>
                    <td class="px-4 py-3 text-sm text-gray-900 dark:text-slate-100">@(detail.Contact?.FullName ?? "-")</td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@(detail.Contact?.Phone ?? "-")</td>
                    <td class="px-4 py-3 text-sm">
                        @{
                            var badgeClass = detail.Status switch
                            {
                                Msgifly.Web.Models.Enums.CampaignDetailStatus.Sent => "bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300",
                                Msgifly.Web.Models.Enums.CampaignDetailStatus.Failed => "bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-300",
                                _ => "bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-300",
                            };
                        }
                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium @badgeClass">@detail.Status</span>
                        @if (detail.DeliveryStatus is not null)
                        {
                            <span class="ml-1 text-xs text-gray-400 dark:text-slate-500">(@detail.DeliveryStatus)</span>
                        }
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400 max-w-xs truncate" title="@detail.ResponseMessage">@detail.ResponseMessage</td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@detail.UpdatedAt.ToString("dd MMM, HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model.Details" />
