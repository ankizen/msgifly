@model Msgifly.Web.Models.ViewModels.ApiKeyFormViewModel
@{
    ViewData["Title"] = "New API Key";
}

<div class="mb-6">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">New API Key</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Grant only the scopes the caller actually needs.</p>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="mb-4 rounded-md bg-red-50 dark:bg-red-900/30 p-3 text-sm text-red-700 dark:text-red-300">
        <div asp-validation-summary="All"></div>
    </div>
}

<form asp-action="Create" method="post" class="max-w-xl space-y-6">
    <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6">
        <label asp-for="Name" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
        <input asp-for="Name" placeholder="e.g. n8n automation"
               class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
    </div>

    <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6">
        <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-3">Scopes</h2>
        <div class="space-y-2">
            @foreach (var scope in Msgifly.Web.Services.ApiKeys.ApiScopes.All)
            {
                <label class="flex items-start gap-2">
                    <input type="checkbox" name="Scopes" value="@scope" class="mt-0.5 rounded border-gray-300 text-emerald-600 shadow-sm focus:ring-emerald-500" />
                    <span class="text-sm">
                        <span class="font-mono text-gray-900 dark:text-slate-100">@scope</span>
                        <span class="block text-gray-500 dark:text-slate-400">@Msgifly.Web.Services.ApiKeys.ApiScopes.Descriptions[scope]</span>
                    </span>
                </label>
            }
        </div>
    </div>

    <div class="flex items-center gap-3">
        <button type="submit" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">Create Key</button>
        <a asp-action="Index" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700">Cancel</a>
    </div>
</form>
