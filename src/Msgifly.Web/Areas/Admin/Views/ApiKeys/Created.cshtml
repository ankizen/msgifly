@model Msgifly.Web.Models.Entities.ApiKey
@{
    ViewData["Title"] = "API Key Created";
    var plaintext = (string)ViewData["Plaintext"]!;
}

<div class="max-w-xl">
    <div class="mb-6">
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">API key created</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Copy it now — this is the only time it will ever be shown.</p>
    </div>

    <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6">
        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">@Model.Name</label>
        <div class="mt-2 flex items-center gap-2" x-data="{ copied: false }">
            <input readonly value="@plaintext" x-ref="keyInput"
                   class="flex-1 font-mono text-sm rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm" />
            <button type="button"
                    x-on:click="navigator.clipboard.writeText($refs.keyInput.value); copied = true; setTimeout(() => copied = false, 2000)"
                    class="px-3 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium whitespace-nowrap">
                <span x-show="!copied">Copy</span>
                <span x-show="copied" x-cloak>Copied!</span>
            </button>
        </div>

        <div class="mt-4 rounded-md bg-yellow-50 dark:bg-yellow-900/30 p-3 text-sm text-yellow-700 dark:text-yellow-300">
            Store this somewhere safe. Msgifly only keeps a one-way hash — if you lose it, revoke this key and create a new one.
        </div>
    </div>

    <div class="mt-6">
        <a asp-action="Index" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium inline-flex">Done</a>
    </div>
</div>
