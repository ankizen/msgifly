@model Msgifly.Web.Models.ViewModels.CannedReplyFormViewModel
@{
    ViewData["Title"] = Model.Id is null ? "New Canned Reply" : "Edit Canned Reply";
}

<div class="mb-6">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">@ViewData["Title"]</h1>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="mb-4 rounded-md bg-red-50 dark:bg-red-900/30 p-3 text-sm text-red-700 dark:text-red-300">
        <div asp-validation-summary="All"></div>
    </div>
}

<form asp-action="Save" method="post" class="max-w-xl space-y-4">
    <input type="hidden" asp-for="Id" />
    <div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6 space-y-4">
        <div>
            <label asp-for="Title" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
            <input asp-for="Title" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
            <span asp-validation-for="Title" class="text-sm text-red-600"></span>
        </div>
        <div>
            <label asp-for="Description" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
            <textarea asp-for="Description" rows="4" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"></textarea>
            <span asp-validation-for="Description" class="text-sm text-red-600"></span>
        </div>
        <label class="inline-flex items-center gap-2">
            <input type="checkbox" asp-for="IsPublic" class="rounded border-gray-300 text-indigo-600 shadow-sm focus:ring-indigo-500" />
            <span class="text-sm text-gray-700 dark:text-slate-300">Visible to all agents</span>
        </label>
    </div>
    <div class="flex gap-3">
        <button type="submit" class="px-4 py-2 rounded-md bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium">Save</button>
        <a asp-action="Index" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700">Cancel</a>
    </div>
</form>
