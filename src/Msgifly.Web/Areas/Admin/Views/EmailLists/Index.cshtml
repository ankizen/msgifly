@model Msgifly.Web.Models.PagedList<Msgifly.Web.Models.Entities.EmailList>
@{
    ViewData["Title"] = "Email Lists";
    var counts = (Dictionary<int, int>)ViewData["MemberCounts"]!;
}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Email Lists</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Group subscribers to target them together in campaigns and automations.</p>
    </div>
    <a asp-action="Save" class="inline-flex items-center px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">
        + Add List
    </a>
</div>

<div class="bg-white dark:bg-slate-800 shadow rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
        <thead class="bg-gray-50 dark:bg-slate-900">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Name</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Subscribers</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
            @if (!Model.Items.Any())
            {
                <tr><td colspan="3" class="px-4 py-6 text-center text-sm text-gray-500 dark:text-slate-400">No lists yet.</td></tr>
            }
            @foreach (var list in Model.Items)
            {
                <tr>
                    <td class="px-4 py-3 text-sm text-gray-900 dark:text-slate-100">
                        @list.Name
                        @if (!string.IsNullOrEmpty(list.Description))
                        {
                            <p class="text-xs text-gray-400 dark:text-slate-500">@list.Description</p>
                        }
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">@(counts.TryGetValue(list.Id, out var c) ? c : 0)</td>
                    <td class="px-4 py-3 text-right text-sm space-x-3">
                        <a asp-action="Save" asp-route-id="@list.Id" class="text-emerald-600 hover:text-emerald-500">Edit</a>
                        <button type="button" class="text-red-600 hover:text-red-500"
                                x-on:click="$dispatch('confirm-delete', { url: '@Url.Action("Delete", new { id = list.Id })', message: 'Delete this list?' })">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model" />
