@model Msgifly.Web.Models.ViewModels.StatusFormViewModel
@{
    ViewData["Title"] = Model.Id is null ? "Add Status" : "Edit Status";
}

<div class="mb-6">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">@ViewData["Title"]</h1>
</div>

<div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6 max-w-lg">
    <form asp-action="Save" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-600"></div>

        <label asp-for="Name" class="block text-sm font-medium text-gray-700 dark:text-slate-300">Name</label>
        <input asp-for="Name" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" autofocus />
        <span asp-validation-for="Name" class="mt-1 block text-sm text-red-600"></span>

        <label asp-for="Color" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mt-4">Color</label>
        <div class="mt-1 flex items-center gap-2" x-data="{ color: '@Model.Color' }">
            <input type="color" x-model="color" class="h-9 w-14 rounded border-gray-300 dark:border-slate-600" />
            <input type="text" asp-for="Color" x-model="color" class="block w-32 rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
        </div>
        <span asp-validation-for="Color" class="mt-1 block text-sm text-red-600"></span>

        <label class="mt-4 inline-flex items-center gap-2">
            <input asp-for="IsDefault" class="rounded border-gray-300 text-indigo-600 shadow-sm focus:ring-indigo-500" />
            <span asp-for="IsDefault" class="text-sm text-gray-700 dark:text-slate-300">@Html.DisplayNameFor(m => m.IsDefault)</span>
        </label>

        <div class="mt-6 flex gap-3">
            <button type="submit" class="px-4 py-2 rounded-md bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium">Save</button>
            <a asp-action="Index" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium">Cancel</a>
        </div>
    </form>
</div>
