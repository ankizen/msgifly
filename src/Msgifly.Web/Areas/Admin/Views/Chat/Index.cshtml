@{
    ViewData["Title"] = "Chat";
    ViewData["IsChatPage"] = true;
}

@Html.AntiForgeryToken()

<div class="flex h-[calc(100vh-4rem)]" x-data="chatInbox()" x-init="init()">

    @* ---------- Conversation list ---------- *@
    <div class="w-full sm:w-80 flex-shrink-0 border-r border-gray-200 dark:border-slate-700 flex flex-col bg-white dark:bg-slate-800"
         x-show="!activeChatId || !isMobile" x-cloak>
        <div class="p-3 border-b border-gray-200 dark:border-slate-700">
            <input type="text" placeholder="Search conversations..." x-model="search" x-on:input.debounce.400ms="loadChats()"
                   class="w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 text-sm shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
        </div>
        <div class="flex-1 overflow-y-auto">
            <template x-if="chats.length === 0">
                <p class="p-4 text-sm text-gray-400 dark:text-slate-500 text-center">No conversations yet.</p>
            </template>
            <template x-for="chat in chats" :key="chat.id">
                <button type="button" x-on:click="selectChat(chat.id)"
                        class="w-full text-left px-3 py-3 flex items-center gap-3 border-b border-gray-100 dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-700"
                        :class="chat.id === activeChatId ? 'bg-emerald-50 dark:bg-slate-900' : ''">
                    <span class="flex-shrink-0 h-10 w-10 rounded-full bg-emerald-600 text-white flex items-center justify-center text-sm font-semibold"
                          x-text="(chat.name || '?').charAt(0).toUpperCase()"></span>
                    <span class="flex-1 min-w-0">
                        <span class="flex items-center justify-between">
                            <span class="text-sm font-medium text-gray-900 dark:text-slate-100 truncate" x-text="chat.name"></span>
                            <span class="text-xs text-gray-400 dark:text-slate-500 flex-shrink-0 ml-2" x-text="formatTime(chat.lastMessageTime)"></span>
                        </span>
                        <span class="flex items-center justify-between">
                            <span class="text-xs text-gray-500 dark:text-slate-400 truncate" x-text="chat.lastMessage"></span>
                            <template x-if="chat.unreadCount > 0">
                                <span class="ml-2 flex-shrink-0 inline-flex items-center justify-center h-5 min-w-[1.25rem] px-1 rounded-full bg-emerald-600 text-white text-xs" x-text="chat.unreadCount"></span>
                            </template>
                        </span>
                    </span>
                </button>
            </template>
        </div>
    </div>

    @* ---------- Message thread ---------- *@
    <div class="flex-1 flex flex-col min-w-0" x-show="activeChatId || !isMobile" x-cloak>
        <template x-if="!activeChatId">
            <div class="flex-1 flex items-center justify-center text-gray-400 dark:text-slate-500 text-sm">
                Select a conversation to start chatting.
            </div>
        </template>

        <template x-if="activeChatId">
            <div class="flex-1 flex flex-col min-h-0">
                <div class="p-3 border-b border-gray-200 dark:border-slate-700 flex items-center justify-between bg-white dark:bg-slate-800">
                    <div class="flex items-center gap-2">
                        <button type="button" class="sm:hidden text-gray-500" x-on:click="activeChatId = null">&larr;</button>
                        <div>
                            <p class="text-sm font-semibold text-gray-900 dark:text-slate-100" x-text="activeChat?.name"></p>
                            <p class="text-xs text-gray-400 dark:text-slate-500" x-text="activeChat?.receiverId"></p>
                        </div>
                    </div>
                    <template x-if="activeChat?.isBotsStopped">
                        <span class="inline-flex items-center rounded-full bg-yellow-100 dark:bg-yellow-900 px-2 py-0.5 text-xs font-medium text-yellow-700 dark:text-yellow-300">Bots paused</span>
                    </template>
                </div>

                <div class="flex-1 overflow-y-auto p-4 space-y-2 bg-gray-50 dark:bg-slate-900" x-ref="messageList">
                    <button type="button" x-show="hasMoreMessages" x-on:click="loadMessages(activeChatId, true)"
                            class="mx-auto block text-xs text-emerald-600 hover:text-emerald-500 mb-2">Load older messages</button>

                    <template x-for="message in messages" :key="message.id">
                        <div class="flex" :class="message.isOutbound ? 'justify-end' : 'justify-start'">
                            <div class="max-w-[75%] rounded-lg px-3 py-2 text-sm shadow-sm"
                                 :class="message.isOutbound ? 'bg-emerald-600 text-white' : 'bg-white dark:bg-slate-700 text-gray-900 dark:text-slate-100'">

                                <template x-if="message.messageType === 'image' || message.messageType === 'sticker'">
                                    <a :href="message.url" target="_blank" rel="noopener">
                                        <img :src="message.url" class="rounded-md max-h-64 max-w-full mb-1" loading="lazy" />
                                    </a>
                                </template>
                                <template x-if="message.messageType === 'video'">
                                    <video :src="message.url" controls class="rounded-md max-h-64 max-w-full mb-1"></video>
                                </template>
                                <template x-if="message.messageType === 'audio'">
                                    <audio :src="message.url" controls class="mb-1 max-w-full"></audio>
                                </template>
                                <template x-if="message.messageType === 'document'">
                                    <a :href="message.url" target="_blank" rel="noopener"
                                       class="flex items-center gap-2 mb-1 px-2 py-1.5 rounded-md"
                                       :class="message.isOutbound ? 'bg-emerald-700' : 'bg-gray-100 dark:bg-slate-600'">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                                        </svg>
                                        <span class="truncate underline">Download document</span>
                                    </a>
                                </template>

                                <p class="whitespace-pre-wrap break-words" x-show="message.message" x-text="message.message"></p>
                                <p class="mt-1 text-[10px] opacity-70 text-right" x-text="formatTime(message.timeSent) + (message.isOutbound ? ' · ' + message.status : '')"></p>
                            </div>
                        </div>
                    </template>
                </div>

                <template x-if="pendingFile">
                    <div class="px-3 py-2 border-t border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-900 flex items-center gap-2 text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.112 2.13" />
                        </svg>
                        <span class="flex-1 truncate text-gray-700 dark:text-slate-300" x-text="pendingFile.name"></span>
                        <button type="button" x-on:click="pendingFile = null; $refs.fileInput.value = ''" class="text-gray-400 hover:text-red-500">&times;</button>
                    </div>
                </template>

                <div class="p-3 border-t border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800">
                    <div class="flex items-end gap-2">
                        <div class="relative" x-data="{ open: false }">
                            <button type="button" x-on:click="open = !open" x-on:click.outside="open = false"
                                    class="p-2 rounded-md text-gray-500 hover:bg-gray-100 dark:hover:bg-slate-700" title="Canned replies">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
                                </svg>
                            </button>
                            <div x-show="open" x-cloak class="absolute bottom-12 left-0 w-72 max-h-64 overflow-y-auto bg-white dark:bg-slate-700 rounded-md shadow-lg ring-1 ring-black ring-opacity-5 py-1 z-10">
                                <template x-if="cannedReplies.length === 0">
                                    <p class="px-3 py-2 text-xs text-gray-400">No canned replies yet.</p>
                                </template>
                                <template x-for="reply in cannedReplies" :key="reply.id">
                                    <button type="button" x-on:click="composeText += (composeText ? ' ' : '') + reply.description; open = false"
                                            class="w-full text-left px-3 py-2 text-sm hover:bg-gray-100 dark:hover:bg-slate-600">
                                        <span class="block font-medium text-gray-900 dark:text-slate-100" x-text="reply.title"></span>
                                        <span class="block text-xs text-gray-400 truncate" x-text="reply.description"></span>
                                    </button>
                                </template>
                            </div>
                        </div>

                        <button type="button" x-on:click="$refs.fileInput.click()"
                                class="p-2 rounded-md text-gray-500 hover:bg-gray-100 dark:hover:bg-slate-700" title="Attach file">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.112 2.13" />
                            </svg>
                        </button>
                        <input type="file" x-ref="fileInput" class="hidden" x-on:change="pendingFile = $event.target.files[0] || null" />

                        <textarea x-model="composeText" rows="1" :placeholder="pendingFile ? 'Add a caption (optional)...' : 'Type a message...'"
                                  x-on:keydown.enter.prevent="sendMessage()"
                                  class="flex-1 resize-none rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 text-sm shadow-sm focus:border-emerald-500 focus:ring-emerald-500"></textarea>

                        <button type="button" x-on:click="sendMessage()" :disabled="sending || (!composeText.trim() && !pendingFile)"
                                class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 disabled:opacity-50 text-white text-sm font-medium">
                            Send
                        </button>
                    </div>
                </div>
            </div>
        </template>
    </div>
</div>

@section Scripts {
<script>
function chatInbox() {
    return {
        chats: [],
        messages: [],
        cannedReplies: [],
        activeChatId: null,
        search: '',
        composeText: '',
        pendingFile: null,
        sending: false,
        hasMoreMessages: false,
        isMobile: window.innerWidth < 640,
        connection: null,

        get activeChat() {
            return this.chats.find(c => c.id === this.activeChatId) || null;
        },

        antiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        },

        async init() {
            await this.loadChats();
            await this.loadCannedReplies();
            this.connectRealtime();
        },

        connectRealtime() {
            this.connection = window.createChatConnection();

            this.connection.on('ReceiveMessage', (chatId, message) => {
                if (chatId === this.activeChatId) {
                    this.messages.push(message);
                    this.$nextTick(() => this.scrollToBottom());
                    if (!message.isOutbound) {
                        this.markAsRead(chatId);
                    }
                }
                this.bumpChat(chatId, message);
            });

            this.connection.on('MessageStatusUpdated', (chatId, messageId, status) => {
                const message = this.messages.find(m => m.id === messageId);
                if (message) message.status = status;
            });

            this.connection.start().catch(err => console.error('SignalR connection failed:', err));
        },

        bumpChat(chatId, message) {
            const chat = this.chats.find(c => c.id === chatId);
            if (chat) {
                chat.lastMessage = message.message;
                chat.lastMessageTime = message.timeSent;
                if (!message.isOutbound && chatId !== this.activeChatId) {
                    chat.unreadCount = (chat.unreadCount || 0) + 1;
                }
                this.chats = [chat, ...this.chats.filter(c => c.id !== chatId)];
            } else {
                this.loadChats();
            }
        },

        async loadChats() {
            const res = await fetch('/Admin/Chat/GetChats?search=' + encodeURIComponent(this.search));
            this.chats = await res.json();
        },

        async loadCannedReplies() {
            const res = await fetch('/Admin/Chat/GetCannedReplies');
            this.cannedReplies = await res.json();
        },

        async selectChat(chatId) {
            this.activeChatId = chatId;
            this.messages = [];
            await this.loadMessages(chatId, false);
            await this.markAsRead(chatId);
            const chat = this.chats.find(c => c.id === chatId);
            if (chat) chat.unreadCount = 0;
            this.$nextTick(() => this.scrollToBottom());
        },

        async loadMessages(chatId, prepend) {
            const beforeId = prepend && this.messages.length > 0 ? this.messages[0].id : '';
            const res = await fetch(`/Admin/Chat/GetMessages?chatId=${chatId}&beforeId=${beforeId}`);
            const page = await res.json();
            this.hasMoreMessages = page.length === 20;
            this.messages = prepend ? [...page, ...this.messages] : page;
        },

        async markAsRead(chatId) {
            await fetch('/Admin/Chat/MarkAsRead', {
                method: 'POST',
                body: new URLSearchParams({ chatId, __RequestVerificationToken: this.antiForgeryToken() }),
            });
        },

        async sendMessage() {
            if ((!this.composeText.trim() && !this.pendingFile) || this.sending) return;
            this.sending = true;

            try {
                let res;
                if (this.pendingFile) {
                    const formData = new FormData();
                    formData.append('chatId', this.activeChatId);
                    formData.append('file', this.pendingFile);
                    formData.append('caption', this.composeText);
                    formData.append('__RequestVerificationToken', this.antiForgeryToken());
                    res = await fetch('/Admin/Chat/SendMedia', { method: 'POST', body: formData });
                } else {
                    res = await fetch('/Admin/Chat/SendMessage', {
                        method: 'POST',
                        body: new URLSearchParams({ chatId: this.activeChatId, text: this.composeText, __RequestVerificationToken: this.antiForgeryToken() }),
                    });
                }

                if (!res.ok) {
                    window.showNotification(await res.text(), 'danger');
                    return;
                }

                const message = await res.json();
                this.messages.push(message);
                this.composeText = '';
                this.pendingFile = null;
                this.$refs.fileInput.value = '';
                this.bumpChat(this.activeChatId, message);
                this.$nextTick(() => this.scrollToBottom());
            } finally {
                this.sending = false;
            }
        },

        scrollToBottom() {
            const el = this.$refs.messageList;
            if (el) el.scrollTop = el.scrollHeight;
        },

        formatTime(value) {
            if (!value) return '';
            const date = new Date(value);
            return date.toLocaleString(undefined, { hour: '2-digit', minute: '2-digit' });
        },
    };
}
</script>
}
