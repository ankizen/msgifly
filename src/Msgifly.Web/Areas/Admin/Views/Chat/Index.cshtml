@{
    ViewData["Title"] = "Chat";
    ViewData["IsChatPage"] = true;
    var templateOptions = (List<Msgifly.Web.Models.ViewModels.TemplateOption>)ViewData["TemplateOptions"]!;
    var statusOptions = ViewData["StatusOptions"]!;
    var sourceOptions = ViewData["SourceOptions"]!;
}

@Html.AntiForgeryToken()

@* Config is read from a plain <script> variable, not embedded inline in the x-data attribute —
   the attribute is itself HTML double-quoted, so raw JSON (which is full of ") would prematurely
   close it and truncate everything after the first quote. *@
<script>
    window.__chatConfig = {
        templates: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(templateOptions, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerOptions.Web))),
        statusOptions: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(statusOptions, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerOptions.Web))),
        sourceOptions: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(sourceOptions, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerOptions.Web))),
    };
</script>

<div class="flex h-[calc(100vh-4rem)]" x-data="chatInbox()" x-init="init()">

    @* ---------- Conversation list ---------- *@
    <div class="w-full sm:w-80 flex-shrink-0 border-r border-gray-200 dark:border-slate-700 flex flex-col bg-white dark:bg-slate-800"
         x-show="!activeChatId || !isMobile" x-cloak>
        <div class="p-3 border-b border-gray-200 dark:border-slate-700">
            <input type="text" placeholder="Search conversations..." x-model="search" x-on:input.debounce.400ms="loadChats()"
                   class="w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 text-sm shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
        </div>
        <div class="flex-1 overflow-y-auto">
            <template x-if="chats.length === 0">
                <p class="p-4 text-sm text-gray-400 dark:text-slate-500 text-center">No conversations yet.</p>
            </template>
            <template x-for="chat in chats" :key="chat.id">
                <button type="button" x-on:click="selectChat(chat.id)"
                        class="w-full text-left px-3 py-3 flex items-center gap-3 border-b border-gray-100 dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-700"
                        :class="chat.id === activeChatId ? 'bg-emerald-50 dark:bg-slate-900' : ''">
                    <span class="flex-shrink-0 h-10 w-10 rounded-full bg-emerald-600 text-white flex items-center justify-center text-sm font-semibold"
                          x-text="(chat.name || '?').charAt(0).toUpperCase()"></span>
                    <span class="flex-1 min-w-0">
                        <span class="flex items-center justify-between">
                            <span class="text-sm font-medium text-gray-900 dark:text-slate-100 truncate" x-text="chat.name"></span>
                            <span class="text-xs text-gray-400 dark:text-slate-500 flex-shrink-0 ml-2" x-text="formatTime(chat.lastMessageTime)"></span>
                        </span>
                        <span class="flex items-center justify-between">
                            <span class="text-xs text-gray-500 dark:text-slate-400 truncate" x-text="chat.lastMessage"></span>
                            <template x-if="chat.unreadCount > 0">
                                <span class="ml-2 flex-shrink-0 inline-flex items-center justify-center h-5 min-w-[1.25rem] px-1 rounded-full bg-emerald-600 text-white text-xs" x-text="chat.unreadCount"></span>
                            </template>
                        </span>
                    </span>
                </button>
            </template>
        </div>
    </div>

    @* ---------- Message thread ---------- *@
    <div class="flex-1 flex flex-col min-w-0" x-show="activeChatId || !isMobile" x-cloak>
        <template x-if="!activeChatId">
            <div class="flex-1 flex items-center justify-center text-gray-400 dark:text-slate-500 text-sm">
                Select a conversation to start chatting.
            </div>
        </template>

        <template x-if="activeChatId">
            <div class="flex-1 flex flex-col min-h-0">
                <div class="p-3 border-b border-gray-200 dark:border-slate-700 flex items-center justify-between bg-white dark:bg-slate-800">
                    <div class="flex items-center gap-2">
                        <button type="button" class="sm:hidden text-gray-500" x-on:click="activeChatId = null">&larr;</button>
                        <div>
                            <p class="text-sm font-semibold text-gray-900 dark:text-slate-100" x-text="activeChat?.name"></p>
                            <p class="text-xs text-gray-400 dark:text-slate-500" x-text="activeChat?.receiverId"></p>
                        </div>
                        <template x-if="activeChat?.contactType === 'Unknown'">
                            <button type="button" x-on:click="openContactModal()"
                                    class="inline-flex items-center gap-1 rounded-full bg-blue-50 dark:bg-blue-900/30 px-2 py-0.5 text-xs font-medium text-blue-700 dark:text-blue-300 hover:bg-blue-100 dark:hover:bg-blue-900/50">
                                Not saved &middot; Add to Contact
                            </button>
                        </template>
                    </div>
                    <div class="flex items-center gap-2">
                        <template x-if="activeChat?.isBotsStopped">
                            <span class="inline-flex items-center rounded-full bg-yellow-100 dark:bg-yellow-900 px-2 py-0.5 text-xs font-medium text-yellow-700 dark:text-yellow-300">Bots paused</span>
                        </template>
                        <template x-if="activeChat && !activeChat.windowOpen">
                            <span class="inline-flex items-center rounded-full bg-orange-100 dark:bg-orange-900 px-2 py-0.5 text-xs font-medium text-orange-700 dark:text-orange-300" title="They haven't messaged in the last 24 hours — only a template message can reach them now.">24h window closed</span>
                        </template>
                        <template x-if="activeChat?.isBlocked">
                            <span class="inline-flex items-center rounded-full bg-red-100 dark:bg-red-900 px-2 py-0.5 text-xs font-medium text-red-700 dark:text-red-300">Blocked</span>
                        </template>
                        <button type="button" x-on:click="toggleBlock()"
                                class="text-xs font-medium px-2 py-1 rounded-md border"
                                :class="activeChat?.isBlocked
                                    ? 'border-emerald-300 text-emerald-600 hover:bg-emerald-50 dark:border-emerald-700 dark:hover:bg-emerald-900/20'
                                    : 'border-red-300 text-red-600 hover:bg-red-50 dark:border-red-700 dark:hover:bg-red-900/20'"
                                x-text="activeChat?.isBlocked ? 'Unblock' : 'Block'"></button>
                    </div>
                </div>

                <div class="flex-1 overflow-y-auto p-4 space-y-2 bg-gray-50 dark:bg-slate-900" x-ref="messageList">
                    <button type="button" x-show="hasMoreMessages" x-on:click="loadMessages(activeChatId, true)"
                            class="mx-auto block text-xs text-emerald-600 hover:text-emerald-500 mb-2">Load older messages</button>

                    <template x-for="message in messages" :key="message.id">
                        <div class="flex" :class="message.isOutbound ? 'justify-end' : 'justify-start'">
                            <div class="max-w-[85%] sm:max-w-sm rounded-lg overflow-hidden text-sm shadow-sm"
                                 :class="message.isOutbound ? 'bg-emerald-600 text-white' : 'bg-white dark:bg-slate-700 text-gray-900 dark:text-slate-100'">

                                @* Image/video headers render edge-to-edge at the top of the bubble, exactly like WhatsApp itself — no padding, only the bubble's own rounded corners. No forced width/object-fit: the full image renders at its own aspect ratio (never cropped), just capped so it can't blow out past the bubble. *@
                                <template x-if="message.messageType === 'image' || message.messageType === 'sticker'">
                                    <a :href="message.url" target="_blank" rel="noopener">
                                        <img :src="message.url" class="block max-w-full max-h-80" loading="lazy" />
                                    </a>
                                </template>
                                <template x-if="message.messageType === 'video'">
                                    <video :src="message.url" controls class="block max-w-full max-h-80"></video>
                                </template>

                                <div class="px-3 py-2">
                                    <template x-if="message.messageType === 'audio'">
                                        <audio :src="message.url" controls class="mb-1 max-w-full"></audio>
                                    </template>
                                    <template x-if="message.messageType === 'document'">
                                        <a :href="message.url" target="_blank" rel="noopener"
                                           class="flex items-center gap-2 mb-1 px-2 py-1.5 rounded-md"
                                           :class="message.isOutbound ? 'bg-emerald-700' : 'bg-gray-100 dark:bg-slate-600'">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                                            </svg>
                                            <span class="truncate underline">Download document</span>
                                        </a>
                                    </template>

                                    <p class="whitespace-pre-wrap break-words" x-show="message.message" x-text="message.message"></p>
                                    <p class="mt-1 text-xs opacity-70 whitespace-pre-wrap break-words" x-show="message.footerText" x-text="message.footerText"></p>
                                    <p class="mt-1 flex items-center justify-end gap-1 text-[10px] opacity-70">
                                        <span x-text="formatTime(message.timeSent)"></span>
                                        <template x-if="message.isOutbound">
                                            <span class="inline-flex items-center">
                                                <!-- Pending: clock -->
                                                <svg x-show="message.status === 'Pending'" xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3">
                                                    <circle cx="8" cy="8" r="6.5" /><path stroke-linecap="round" d="M8 4.5V8l2.5 1.5" />
                                                </svg>
                                                <!-- Sent: single tick -->
                                                <svg x-show="message.status === 'Sent'" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 16 11" fill="none" stroke="currentColor" stroke-width="1.5">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M1 6l3.5 3.5L14 1" />
                                                </svg>
                                                <!-- Delivered: double tick, grey -->
                                                <svg x-show="message.status === 'Delivered'" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-4" viewBox="0 0 20 11" fill="none" stroke="currentColor" stroke-width="1.5">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M1 6l3.5 3.5L11 2" /><path stroke-linecap="round" stroke-linejoin="round" d="M6.5 6l3.5 3.5L19 1" />
                                                </svg>
                                                <!-- Read: double tick, blue -->
                                                <svg x-show="message.status === 'Read'" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-4" viewBox="0 0 20 11" fill="none" stroke="#53bdeb" stroke-width="1.5">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M1 6l3.5 3.5L11 2" /><path stroke-linecap="round" stroke-linejoin="round" d="M6.5 6l3.5 3.5L19 1" />
                                                </svg>
                                                <!-- Failed: warning -->
                                                <svg x-show="message.status === 'Failed'" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-red-400" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                                    <circle cx="8" cy="8" r="6.5" /><path stroke-linecap="round" d="M8 5v3.5" /><circle cx="8" cy="10.8" r="0.6" fill="currentColor" stroke="none" />
                                                </svg>
                                            </span>
                                        </template>
                                    </p>
                                </div>

                                @* Template buttons render as full-width rows below the bubble content, same convention as the template editor's own live preview. *@
                                <template x-for="(btn, bidx) in parseButtons(message.buttonsJson)" :key="bidx">
                                    <a :href="btn.href" target="_blank" rel="noopener"
                                       class="flex items-center justify-center gap-1.5 py-2 text-sm border-t"
                                       :class="message.isOutbound ? 'border-emerald-500 text-white hover:bg-emerald-700' : 'border-gray-100 dark:border-slate-600 text-blue-600 dark:text-blue-400 hover:bg-gray-50 dark:hover:bg-slate-600'">
                                        <svg x-show="btn.type === 'URL'" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
                                        <svg x-show="btn.type === 'PHONE_NUMBER'" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h1.5a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106a1.125 1.125 0 00-1.173.417l-.97 1.293a11.25 11.25 0 01-6.223-6.223l1.293-.97a1.125 1.125 0 00.417-1.173L8.663 3.102a1.125 1.125 0 00-1.091-.852H6.75A2.25 2.25 0 004.5 4.5v2.25z" /></svg>
                                        <span x-text="btn.text"></span>
                                    </a>
                                </template>
                            </div>
                        </div>
                    </template>
                </div>

                <template x-if="pendingFile">
                    <div class="px-3 py-2 border-t border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-900 flex items-center gap-2 text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.112 2.13" />
                        </svg>
                        <span class="flex-1 truncate text-gray-700 dark:text-slate-300" x-text="pendingFile.name"></span>
                        <button type="button" x-on:click="pendingFile = null; $refs.fileInput.value = ''" class="text-gray-400 hover:text-red-500">&times;</button>
                    </div>
                </template>

                <template x-if="activeChat?.isBlocked">
                    <div class="p-3 border-t border-gray-200 dark:border-slate-700 bg-red-50 dark:bg-red-900/20 text-center text-sm text-red-600 dark:text-red-300">
                        This contact is blocked — <button type="button" x-on:click="toggleBlock()" class="underline font-medium">unblock</button> to send messages.
                    </div>
                </template>
                <template x-if="!activeChat?.isBlocked && activeChat && !activeChat.windowOpen">
                    <div class="p-3 border-t border-gray-200 dark:border-slate-700 bg-orange-50 dark:bg-orange-900/20 text-center text-sm text-orange-700 dark:text-orange-300">
                        24-hour window closed — they haven't messaged recently, so only a template can reach them.
                        <button type="button" x-on:click="openTemplateModal()" class="underline font-medium">Send a template</button>
                    </div>
                </template>
                <template x-if="!activeChat?.isBlocked">
                <div class="p-3 border-t border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800">
                    <div class="flex items-end gap-2">
                        <div class="relative" x-data="{ open: false }">
                            <button type="button" x-on:click="open = !open" x-on:click.outside="open = false"
                                    class="p-2 rounded-md text-gray-500 hover:bg-gray-100 dark:hover:bg-slate-700" title="Canned replies">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
                                </svg>
                            </button>
                            <div x-show="open" x-cloak class="absolute bottom-12 left-0 w-72 max-h-64 overflow-y-auto bg-white dark:bg-slate-700 rounded-md shadow-lg ring-1 ring-black ring-opacity-5 py-1 z-10">
                                <template x-if="cannedReplies.length === 0">
                                    <p class="px-3 py-2 text-xs text-gray-400">No canned replies yet.</p>
                                </template>
                                <template x-for="reply in cannedReplies" :key="reply.id">
                                    <button type="button" x-on:click="composeText += (composeText ? ' ' : '') + reply.description; open = false"
                                            class="w-full text-left px-3 py-2 text-sm hover:bg-gray-100 dark:hover:bg-slate-600">
                                        <span class="block font-medium text-gray-900 dark:text-slate-100" x-text="reply.title"></span>
                                        <span class="block text-xs text-gray-400 truncate" x-text="reply.description"></span>
                                    </button>
                                </template>
                            </div>
                        </div>

                        <button type="button" x-on:click="$refs.fileInput.click()"
                                class="p-2 rounded-md text-gray-500 hover:bg-gray-100 dark:hover:bg-slate-700" title="Attach file">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.112 2.13" />
                            </svg>
                        </button>
                        <input type="file" x-ref="fileInput" class="hidden" x-on:change="pendingFile = $event.target.files[0] || null" />

                        <button type="button" x-on:click="openTemplateModal()"
                                class="p-2 rounded-md text-gray-500 hover:bg-gray-100 dark:hover:bg-slate-700" title="Send template">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
                            </svg>
                        </button>

                        <textarea x-model="composeText" rows="1" :placeholder="pendingFile ? 'Add a caption (optional)...' : 'Type a message...'"
                                  x-on:keydown.enter.prevent="sendMessage()"
                                  x-on:input="autoGrowCompose($event.target)"
                                  x-effect="!composeText && $el.style.removeProperty('height')"
                                  class="flex-1 resize-none rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 text-sm shadow-sm focus:border-emerald-500 focus:ring-emerald-500 max-h-40 overflow-y-auto"></textarea>

                        <button type="button" x-on:click="sendMessage()" :disabled="sending || (!composeText.trim() && !pendingFile)"
                                class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 disabled:opacity-50 text-white text-sm font-medium">
                            Send
                        </button>
                    </div>
                </div>
                </template>
            </div>
        </template>
    </div>

    @* ---------- Add to Contact modal ---------- *@
    <div x-show="contactModalOpen" x-cloak class="fixed inset-0 z-40 overflow-y-auto" style="display: none;">
        <div class="fixed inset-0 bg-black/40" x-on:click="contactModalOpen = false"></div>
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="relative bg-white dark:bg-slate-800 rounded-lg shadow-xl max-w-md w-full p-6" x-on:click.stop>
                <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">Add to Contact</h2>
                <p class="text-sm text-gray-500 dark:text-slate-400 mb-4" x-text="activeChat?.receiverId"></p>

                <div class="space-y-3">
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">First name</label>
                            <input x-model="contactForm.firstName" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm text-sm focus:border-emerald-500 focus:ring-emerald-500" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">Last name</label>
                            <input x-model="contactForm.lastName" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm text-sm focus:border-emerald-500 focus:ring-emerald-500" />
                        </div>
                    </div>
                    <div class="grid grid-cols-3 gap-3">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">Type</label>
                            <select x-model="contactForm.type" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm text-sm focus:border-emerald-500 focus:ring-emerald-500">
                                <option value="Lead">Lead</option>
                                <option value="Customer">Customer</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">Status</label>
                            <select x-model.number="contactForm.statusId" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm text-sm focus:border-emerald-500 focus:ring-emerald-500">
                                <template x-for="s in statusOptions" :key="s.id">
                                    <option :value="s.id" x-text="s.name"></option>
                                </template>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">Source</label>
                            <select x-model.number="contactForm.sourceId" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm text-sm focus:border-emerald-500 focus:ring-emerald-500">
                                <template x-for="s in sourceOptions" :key="s.id">
                                    <option :value="s.id" x-text="s.name"></option>
                                </template>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-3 pt-4">
                    <button type="button" x-on:click="submitAddContact()" :disabled="!contactForm.firstName.trim()"
                            class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 disabled:opacity-50 text-white text-sm font-medium">Add contact</button>
                    <button type="button" x-on:click="contactModalOpen = false" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    @* ---------- Send Template modal ---------- *@
    <div x-show="templateModalOpen" x-cloak class="fixed inset-0 z-40 overflow-y-auto" style="display: none;">
        <div class="fixed inset-0 bg-black/40" x-on:click="templateModalOpen = false"></div>
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="relative bg-white dark:bg-slate-800 rounded-lg shadow-xl max-w-lg w-full p-6" x-on:click.stop>
                <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">Send Template</h2>
                <p class="text-sm text-gray-500 dark:text-slate-400 mb-4" x-text="'To: ' + (activeChat?.name || '')"></p>

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">Template</label>
                        <select x-model="templateForm.templateId" x-on:change="onTemplateFormChange()"
                                class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
                            <option value="">Choose a template...</option>
                            <template x-for="t in templates" :key="t.templateId">
                                <option :value="t.templateId" x-text="t.name"></option>
                            </template>
                        </select>
                    </div>

                    <template x-if="selectedTemplateForSend && selectedTemplateForSend.headerFormat === 'TEXT' && selectedTemplateForSend.headerParamsCount > 0">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">Header text</label>
                            <input x-model="templateForm.headerParam" placeholder="Value for {{1}} in the header"
                                   class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm text-sm focus:border-emerald-500 focus:ring-emerald-500" />
                        </div>
                    </template>
                    <template x-if="selectedTemplateForSend && ['IMAGE', 'VIDEO', 'DOCUMENT'].includes(selectedTemplateForSend.headerFormat)">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">Header media URL</label>
                            <input x-model="templateForm.headerParam" placeholder="https://..."
                                   class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm text-sm focus:border-emerald-500 focus:ring-emerald-500" />
                        </div>
                    </template>

                    <template x-if="selectedTemplateForSend && selectedTemplateForSend.bodyParamsCount > 0">
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-gray-700 dark:text-slate-300">Body variables</label>
                            <template x-for="(param, index) in templateForm.bodyParams" :key="index">
                                <input x-model="templateForm.bodyParams[index]" :placeholder="'{{' + (index + 1) + '}}'"
                                       class="block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm text-sm focus:border-emerald-500 focus:ring-emerald-500" />
                            </template>
                        </div>
                    </template>

                    <template x-if="selectedTemplateForSend">
                        <div>
                            <p class="text-xs font-medium text-gray-500 dark:text-slate-400 mb-1">Preview</p>
                            <p class="text-xs text-gray-600 dark:text-slate-300 bg-gray-50 dark:bg-slate-900 rounded-md p-3 whitespace-pre-wrap" x-text="templatePreviewText()"></p>
                        </div>
                    </template>
                </div>

                <div class="flex items-center gap-3 pt-4">
                    <button type="button" x-on:click="submitSendTemplate()" :disabled="!templateForm.templateId || sendingTemplate"
                            class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 disabled:opacity-50 text-white text-sm font-medium">Send</button>
                    <button type="button" x-on:click="templateModalOpen = false" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function chatInbox() {
    const config = window.__chatConfig;
    return {
        chats: [],
        messages: [],
        cannedReplies: [],
        activeChatId: null,
        search: '',
        composeText: '',
        pendingFile: null,
        sending: false,
        hasMoreMessages: false,
        isMobile: window.innerWidth < 640,
        connection: null,

        templates: config.templates,
        statusOptions: config.statusOptions,
        sourceOptions: config.sourceOptions,

        contactModalOpen: false,
        contactForm: { firstName: '', lastName: '', type: 'Lead', statusId: config.statusOptions[0]?.id ?? null, sourceId: config.sourceOptions[0]?.id ?? null },

        templateModalOpen: false,
        templateForm: { templateId: '', headerParam: '', bodyParams: [] },
        sendingTemplate: false,

        get activeChat() {
            return this.chats.find(c => c.id === this.activeChatId) || null;
        },

        get selectedTemplateForSend() {
            return this.templates.find(t => t.templateId === this.templateForm.templateId) || null;
        },

        antiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        },

        async init() {
            await this.loadChats();
            await this.loadCannedReplies();
            this.connectRealtime();
        },

        // Sending a message both returns it directly in the HTTP response (for the immediate,
        // optimistic append below) AND gets broadcast back over SignalR to every connected
        // client — including the sender's own connection. Without this dedup, the same message
        // id lands in `messages` twice, and Alpine's x-for :key="message.id" reconciliation
        // breaks on the duplicate key (messages appearing to vanish/reorder unpredictably as
        // more arrive). Same guard covers a SignalR reconnect ever redelivering a message.
        addMessageIfNew(message) {
            if (this.messages.some(m => m.id === message.id)) {
                return false;
            }
            this.messages.push(message);
            return true;
        },

        connectRealtime() {
            this.connection = window.createChatConnection();

            this.connection.on('ReceiveMessage', (chatId, message) => {
                if (chatId === this.activeChatId) {
                    const added = this.addMessageIfNew(message);
                    if (added) {
                        this.$nextTick(() => this.scrollToBottom());
                        if (!message.isOutbound) {
                            this.markAsRead(chatId);
                        }
                    }
                }
                this.bumpChat(chatId, message);
            });

            this.connection.on('MessageStatusUpdated', (chatId, messageId, status) => {
                const message = this.messages.find(m => m.id === messageId);
                if (message) message.status = status;
            });

            this.connection.start().catch(err => console.error('SignalR connection failed:', err));
        },

        bumpChat(chatId, message) {
            const chat = this.chats.find(c => c.id === chatId);
            if (chat) {
                chat.lastMessage = message.message;
                chat.lastMessageTime = message.timeSent;
                if (!message.isOutbound && chatId !== this.activeChatId) {
                    chat.unreadCount = (chat.unreadCount || 0) + 1;
                }
                this.chats = [chat, ...this.chats.filter(c => c.id !== chatId)];
            } else {
                this.loadChats();
            }
        },

        async loadChats() {
            const res = await fetch('/Admin/Chat/GetChats?search=' + encodeURIComponent(this.search));
            this.chats = await res.json();
        },

        async toggleBlock() {
            if (!this.activeChatId) return;
            const res = await fetch('/Admin/Chat/ToggleBlock', {
                method: 'POST',
                body: new URLSearchParams({ chatId: this.activeChatId, __RequestVerificationToken: this.antiForgeryToken() }),
            });
            if (!res.ok) {
                window.showNotification('Could not update block status.', 'danger');
                return;
            }
            const { isBlocked } = await res.json();
            const chat = this.chats.find(c => c.id === this.activeChatId);
            if (chat) chat.isBlocked = isBlocked;
        },

        async loadCannedReplies() {
            const res = await fetch('/Admin/Chat/GetCannedReplies');
            this.cannedReplies = await res.json();
        },

        async selectChat(chatId) {
            this.activeChatId = chatId;
            this.messages = [];
            await this.loadMessages(chatId, false);
            await this.markAsRead(chatId);
            const chat = this.chats.find(c => c.id === chatId);
            if (chat) chat.unreadCount = 0;
            this.$nextTick(() => this.scrollToBottom());
        },

        async loadMessages(chatId, prepend) {
            const beforeId = prepend && this.messages.length > 0 ? this.messages[0].id : '';
            const res = await fetch(`/Admin/Chat/GetMessages?chatId=${chatId}&beforeId=${beforeId}`);
            const page = await res.json();
            this.hasMoreMessages = page.length === 20;
            this.messages = prepend ? [...page, ...this.messages] : page;
        },

        async markAsRead(chatId) {
            await fetch('/Admin/Chat/MarkAsRead', {
                method: 'POST',
                body: new URLSearchParams({ chatId, __RequestVerificationToken: this.antiForgeryToken() }),
            });
        },

        async sendMessage() {
            if ((!this.composeText.trim() && !this.pendingFile) || this.sending) return;
            this.sending = true;

            try {
                let res;
                if (this.pendingFile) {
                    const formData = new FormData();
                    formData.append('chatId', this.activeChatId);
                    formData.append('file', this.pendingFile);
                    formData.append('caption', this.composeText);
                    formData.append('__RequestVerificationToken', this.antiForgeryToken());
                    res = await fetch('/Admin/Chat/SendMedia', { method: 'POST', body: formData });
                } else {
                    res = await fetch('/Admin/Chat/SendMessage', {
                        method: 'POST',
                        body: new URLSearchParams({ chatId: this.activeChatId, text: this.composeText, __RequestVerificationToken: this.antiForgeryToken() }),
                    });
                }

                if (!res.ok) {
                    window.showNotification(await res.text(), 'danger');
                    return;
                }

                const message = await res.json();
                this.addMessageIfNew(message);
                this.composeText = '';
                this.pendingFile = null;
                this.$refs.fileInput.value = '';
                this.bumpChat(this.activeChatId, message);
                this.$nextTick(() => this.scrollToBottom());
            } finally {
                this.sending = false;
            }
        },

        scrollToBottom() {
            const el = this.$refs.messageList;
            if (el) el.scrollTop = el.scrollHeight;
        },

        formatTime(value) {
            if (!value) return '';
            const date = new Date(value);
            return date.toLocaleString(undefined, { hour: '2-digit', minute: '2-digit' });
        },

        // Tolerant of both shapes ButtonsJson can actually be stored in: Meta's own sync format
        // (lowercase/snake_case, e.g. phone_number) and this app's locally-authored format
        // (PascalCase C# property names) — see WhatsAppService.ParseTemplateNode vs. the
        // create/edit template path for why these differ.
        parseButtons(buttonsJson) {
            if (!buttonsJson) return [];
            let arr;
            try {
                arr = JSON.parse(buttonsJson);
            } catch {
                return [];
            }
            if (!Array.isArray(arr)) return [];

            return arr.map(b => {
                const type = b.type || b.Type || 'QUICK_REPLY';
                const text = b.text || b.Text || (type === 'URL' ? 'Visit link' : type === 'PHONE_NUMBER' ? 'Call' : type === 'COPY_CODE' ? 'Copy code' : 'Quick reply');
                const url = b.url || b.Url || null;
                const phoneNumber = b.phone_number || b.PhoneNumber || b.phoneNumber || null;
                const href = type === 'URL' && url ? url : (type === 'PHONE_NUMBER' && phoneNumber ? 'tel:' + phoneNumber : undefined);
                return { type, text, href };
            });
        },

        // Grows the compose box up to a max height as the admin types a longer message, instead
        // of staying pinned at a single line — matches WhatsApp Web's own compose box.
        autoGrowCompose(el) {
            el.style.height = 'auto';
            el.style.height = Math.min(el.scrollHeight, 160) + 'px';
        },

        openContactModal() {
            if (!this.activeChat) return;
            // activeChat.name falls back to the phone number itself when there's no saved Contact
            // (see ChatController.GetChats) — don't split a phone number into first/last name.
            const hasRealName = this.activeChat.name && this.activeChat.name !== this.activeChat.receiverId;
            const guessedName = hasRealName ? this.activeChat.name.trim().split(/\s+/) : [];
            this.contactForm = {
                firstName: guessedName[0] || '',
                lastName: guessedName.slice(1).join(' '),
                type: 'Lead',
                statusId: this.statusOptions[0]?.id ?? null,
                sourceId: this.sourceOptions[0]?.id ?? null,
            };
            this.contactModalOpen = true;
        },

        async submitAddContact() {
            if (!this.contactForm.firstName.trim() || !this.activeChatId) return;

            const res = await fetch('/Admin/Chat/AddContact', {
                method: 'POST',
                body: new URLSearchParams({
                    chatId: this.activeChatId,
                    firstName: this.contactForm.firstName,
                    lastName: this.contactForm.lastName,
                    type: this.contactForm.type,
                    statusId: this.contactForm.statusId,
                    sourceId: this.contactForm.sourceId,
                    __RequestVerificationToken: this.antiForgeryToken(),
                }),
            });

            if (!res.ok) {
                window.showNotification(await res.text(), 'danger');
                return;
            }

            const { contactType, contactName } = await res.json();
            const chat = this.chats.find(c => c.id === this.activeChatId);
            if (chat) {
                chat.contactType = contactType;
                if (contactName) chat.name = contactName;
            }
            this.contactModalOpen = false;
            window.showNotification('Contact added.', 'success');
        },

        openTemplateModal() {
            this.templateForm = { templateId: '', headerParam: '', bodyParams: [] };
            this.templateModalOpen = true;
        },

        onTemplateFormChange() {
            const t = this.selectedTemplateForSend;
            this.templateForm.bodyParams = t ? Array.from({ length: t.bodyParamsCount }, () => '') : [];
            this.templateForm.headerParam = '';
        },

        templatePreviewText() {
            const t = this.selectedTemplateForSend;
            if (!t) return '';
            let text = t.bodyText || '';
            (this.templateForm.bodyParams || []).forEach((value, index) => {
                text = text.replace(`{{${index + 1}}}`, value || `{{${index + 1}}}`);
            });
            return text;
        },

        async submitSendTemplate() {
            if (!this.templateForm.templateId || !this.activeChatId || this.sendingTemplate) return;
            this.sendingTemplate = true;

            try {
                const body = new URLSearchParams({
                    chatId: this.activeChatId,
                    templateId: this.templateForm.templateId,
                    headerParam: this.templateForm.headerParam || '',
                    __RequestVerificationToken: this.antiForgeryToken(),
                });
                (this.templateForm.bodyParams || []).forEach(v => body.append('bodyParams', v || ''));

                const res = await fetch('/Admin/Chat/SendTemplate', { method: 'POST', body });
                if (!res.ok) {
                    window.showNotification(await res.text(), 'danger');
                    return;
                }

                const message = await res.json();
                this.addMessageIfNew(message);
                this.bumpChat(this.activeChatId, message);
                this.templateModalOpen = false;
                this.$nextTick(() => this.scrollToBottom());
            } finally {
                this.sendingTemplate = false;
            }
        },
    };
}
</script>
}
