@model Msgifly.Web.Models.ViewModels.UserFormViewModel
@{
    ViewData["Title"] = Model.Id is null ? "Add User" : "Edit User";
}

<div class="mb-6">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">@ViewData["Title"]</h1>
</div>

<div class="bg-white dark:bg-slate-800 shadow rounded-lg p-6 max-w-2xl">
    <form asp-action="Save" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-600"></div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label asp-for="FirstName" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                <input asp-for="FirstName" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" autofocus />
                <span asp-validation-for="FirstName" class="mt-1 block text-sm text-red-600"></span>
            </div>
            <div>
                <label asp-for="LastName" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                <input asp-for="LastName" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                <span asp-validation-for="LastName" class="mt-1 block text-sm text-red-600"></span>
            </div>
            <div>
                <label asp-for="Email" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                <input asp-for="Email" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                <span asp-validation-for="Email" class="mt-1 block text-sm text-red-600"></span>
            </div>
            <div>
                <label asp-for="Phone" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                <input asp-for="Phone" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                <span asp-validation-for="Phone" class="mt-1 block text-sm text-red-600"></span>
            </div>
            <div>
                <label asp-for="RoleId" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                <select asp-for="RoleId" asp-items="Model.RoleOptions" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
                    <option value="">-- No role --</option>
                </select>
            </div>
            <div>
                <label asp-for="Password" class="block text-sm font-medium text-gray-700 dark:text-slate-300">
                    Password @(Model.Id is not null ? "(leave blank to keep current)" : "")
                </label>
                <input asp-for="Password" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                <span asp-validation-for="Password" class="mt-1 block text-sm text-red-600"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 dark:text-slate-300"></label>
                <input asp-for="ConfirmPassword" class="mt-1 block w-full rounded-md border-gray-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                <span asp-validation-for="ConfirmPassword" class="mt-1 block text-sm text-red-600"></span>
            </div>
        </div>

        <div class="mt-4 flex flex-col gap-2">
            <label class="inline-flex items-center gap-2">
                <input asp-for="Active" class="rounded border-gray-300 text-emerald-600 shadow-sm focus:ring-emerald-500" />
                <span class="text-sm text-gray-700 dark:text-slate-300">@Html.DisplayNameFor(m => m.Active)</span>
            </label>
            <label class="inline-flex items-center gap-2">
                <input asp-for="IsAdmin" class="rounded border-gray-300 text-emerald-600 shadow-sm focus:ring-emerald-500" />
                <span class="text-sm text-gray-700 dark:text-slate-300">@Html.DisplayNameFor(m => m.IsAdmin)</span>
            </label>
        </div>

        <div class="mt-6 flex gap-3">
            <button type="submit" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">Save</button>
            <a asp-action="Index" class="px-4 py-2 rounded-md border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium">Cancel</a>
        </div>
    </form>
</div>
